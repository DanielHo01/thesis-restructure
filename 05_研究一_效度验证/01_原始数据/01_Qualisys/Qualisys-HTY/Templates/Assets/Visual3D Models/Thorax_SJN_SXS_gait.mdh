/REFERENCE_OBJECT_TYPES=+LANDMARK+TARGET+TARGET+++METRIC+METRIC+METRIC
/USE_CAL_TARGETS_FOR_TRACKING=FALSE
/TRACKING_TYPES=TARGET+TARGET+TARGET+TARGET+TARGET+TARGET
/TRACKING_NAMES=CV7+L_SIA+R_SIA+SJN+SXS+TV10
