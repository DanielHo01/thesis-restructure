!
! Model Metric Values
!
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Segment_to_COFP_Distance
/METRIC_VALUE=0.2
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Joint_Radius_Ratio
/METRIC_VALUE=1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_C
/METRIC_VALUE=0.115*Right_Leg_Length-0.0153
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_C
/METRIC_VALUE=0.115*Left_Leg_Length-0.0153
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=beta
/METRIC_VALUE=18.0*PI/180.0
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=theta
/METRIC_VALUE=28.4*PI/180.0
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RMarker
/METRIC_VALUE=0.007
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_S
/METRIC_VALUE=1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_S
/METRIC_VALUE=-1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_X
/METRIC_VALUE=-Right_S*(Right_C*sin(theta)-0.5*ASIS_Distance)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_X
/METRIC_VALUE=-Left_S*(Left_C*sin(theta)-0.5*ASIS_Distance)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_Y
/METRIC_VALUE=(-Right_ASIS_GT_Distance-RMarker)*cos(beta)+(Right_C*cos(theta)*sin(beta))
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_Y
/METRIC_VALUE=(-Left_ASIS_GT_Distance-RMarker)*cos(beta)+(Left_C*cos(theta)*sin(beta))
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_Z
/METRIC_VALUE=(-Right_ASIS_GT_Distance-RMarker)*sin(beta)-Right_C*cos(theta)*cos(beta)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_Z
/METRIC_VALUE=(-Left_ASIS_GT_Distance-RMarker)*sin(beta)-Left_C*cos(theta)*cos(beta)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Foot_Width
/METRIC_VALUE=0.057
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Foot_Width
/METRIC_VALUE=0.057
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RHE_Distal_Radius
/METRIC_VALUE=distance(MIDBACKHEAD,R_BHD)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RHE_Proximal_Radius
/METRIC_VALUE=distance(MIDFRONTHEAD,R_FHD)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RTA_Distal_Radius
/METRIC_VALUE=0.5*distance(L_SAE,R_SAE)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RTA_Proximal_Radius
/METRIC_VALUE=0.5*distance(R_SAE,L_SAE)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RTA_Segment_Depth
/METRIC_VALUE=0.14
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LShoulderOffset
/METRIC_VALUE=0.05
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RShoulderOffset
/METRIC_VALUE=0.05
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RElbowOffset
/METRIC_VALUE=0.08
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LElbowOffset
/METRIC_VALUE=0.08
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RWristOffset
/METRIC_VALUE=0.04
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LWristOffset
/METRIC_VALUE=0.04
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RHandOffset
/METRIC_VALUE=0.03
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LHandOffset
/METRIC_VALUE=0.03
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Marker_Diameter
/METRIC_VALUE=0.014
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RAR_Distal_Radius
