!
! Model File Generated by Visual3D ModelBuilder
!
!
! Method For Computing Model Pose
!
!
! Model Pose Pipeline
!
!
! Model Metric Values
!
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Mass
/METRIC_VALUE=100
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Height
/METRIC_VALUE=2
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Gravity
/METRIC_VALUE=9.81
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Segment_to_COFP_Distance
/METRIC_VALUE=20
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Joint_Radius_Ratio
/METRIC_VALUE=1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=ASIS_Distance
/METRIC_VALUE=DISTANCE(R_IAS,L_IAS)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Leg_Length
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Leg_Length
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=R_knee_Width
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=L_knee_Width
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=R_ankle_Width
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=L_ankle_Width
/METRIC_VALUE=0.000000000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_ASIS_GT_Distance
/METRIC_VALUE=0.1288*Right_Leg_Length-0.04856
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_ASIS_GT_Distance
/METRIC_VALUE=0.1288*Left_Leg_Length-0.04856
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_C
/METRIC_VALUE=0.115*Right_Leg_Length-0.0153
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_C
/METRIC_VALUE=0.115*Left_Leg_Length-0.0153
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=beta
/METRIC_VALUE=18.0*PI/180.0
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=theta
/METRIC_VALUE=28.4*PI/180.0
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RMarker
/METRIC_VALUE=0.007
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_S
/METRIC_VALUE=1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_S
/METRIC_VALUE=-1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_X
/METRIC_VALUE=-Right_S*(Right_C*sin(theta)-0.5*ASIS_Distance)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_X
/METRIC_VALUE=-Left_S*(Left_C*sin(theta)-0.5*ASIS_Distance)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_Y
/METRIC_VALUE=(-Right_ASIS_GT_Distance-RMarker)*cos(beta)+(Right_C*cos(theta)*sin(beta))
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_Y
/METRIC_VALUE=(-Left_ASIS_GT_Distance-RMarker)*cos(beta)+(Left_C*cos(theta)*sin(beta))
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Hip_Z
/METRIC_VALUE=(-Right_ASIS_GT_Distance-RMarker)*sin(beta)-Right_C*cos(theta)*cos(beta)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Hip_Z
/METRIC_VALUE=(-Left_ASIS_GT_Distance-RMarker)*sin(beta)-Left_C*cos(theta)*cos(beta)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RTH_Proximal_Radius
/METRIC_VALUE=0.5*DISTANCE(RIGHT_HIP, LEFT_HIP)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LTH_Proximal_Radius
/METRIC_VALUE=0.5*DISTANCE(RIGHT_HIP, LEFT_HIP)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RSK_Distal_Radius
/METRIC_VALUE=0.5*distance(R_FAL, R_TAM)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LSK_Distal_Radius
/METRIC_VALUE=0.5*distance(L_FAL,L_TAM)
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RFT_Distal_Radius
/METRIC_VALUE=Right_Foot_Width/2
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RPV_Segment_Depth
/METRIC_VALUE=0.0834979
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Right_Foot_Width
/METRIC_VALUE=0.057
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Left_Foot_Width
/METRIC_VALUE=0.057
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LFT_Distal_Radius
/METRIC_VALUE=Left_Foot_Width/2
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LShoulderOffset
/METRIC_VALUE=0.05
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RShoulderOffset
/METRIC_VALUE=0.05
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RElbowOffset
/METRIC_VALUE=0.08
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LElbowOffset
/METRIC_VALUE=0.08
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RWristOffset
/METRIC_VALUE=0.04
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LWristOffset
/METRIC_VALUE=0.04
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RHandOffset
/METRIC_VALUE=0.03
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LHandOffset
/METRIC_VALUE=0.03
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Marker_Diameter
/METRIC_VALUE=0.014
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=VirtualLab_Distal_Radius
/METRIC_VALUE=0.001
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=VirtualLab_Proximal_Radius
/METRIC_VALUE=0.001
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LFOOT_1_Distal_Radius
/METRIC_VALUE=0.1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LFOOT_1_Proximal_Radius
/METRIC_VALUE=0.1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RFOOT_1_Distal_Radius
/METRIC_VALUE=0.1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RFOOT_1_Proximal_Radius
/METRIC_VALUE=0.1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=Target_Radius_ASIS
/METRIC_VALUE=0.0000
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=ASIS_SACR
/METRIC_VALUE=DISTANCE((0.5*(L_IAS+R_IAS)),(0.5*(L_IPS+R_IPS)))
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=RMF_Distal_Radius
/METRIC_VALUE=0.1
;
Set_Model_Metric
! /CALIBRATION_FILE=
/METRIC_NAME=LMF_Distal_Radius
/METRIC_VALUE=0.1
;
