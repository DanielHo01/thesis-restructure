Set_Pipeline_Parameter_To_List_Of_Signal_Names
/PARAMETER_NAME=signals
/SIGNAL_TYPES=P2D
/SIGNAL_FOLDER=PROCESSED
;

For_Each
/ITERATION_PARAMETER_NAME=signal
! /ITERATION_PARAMETER_COUNT_NAME=
/ITEMS=::signals
;

Evaluate_Expression
  /EXPRESSION=(P2D::PROCESSED::&::signal&::COLON&::COLON&2 - P2D::PROCESSED::&::signal&::COLON&::COLON&3) / 1000000
  /RESULT_NAME=&::signal
  /RESULT_TYPE=DERIVED
  /RESULT_FOLDER=NORM_LOWER
;

Evaluate_Expression
  /EXPRESSION=(2 * P2D::PROCESSED::&::signal&::COLON&::COLON&3) / 1000000
  /RESULT_NAME=&::signal
  /RESULT_TYPE=DERIVED
  /RESULT_FOLDER=NORM_RANGE
;

End_For_Each
/ITERATION_PARAMETER_NAME=signal
;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=DERIVED
/SIGNAL_FOLDER=NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_LOWER+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE+NORM_RANGE
