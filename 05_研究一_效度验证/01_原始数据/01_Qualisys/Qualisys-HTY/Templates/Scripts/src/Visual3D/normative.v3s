!
! BEFORE running this script:
! 1. Copy CMO files into one folder
! 2. In Visual3D Set CMO libraty path to that folder
! 3. Catalog files (Maintnance -> Catalog CMO files)
! 4. Run this script
!
! AFTER script is completed:
! 5. Set Workspace to GLOBAL
! 6. In data tree open P2D folder
! 7. Right-click on PROCESSED folder -> Export folder to normal database (.vnd)
! 8. Set filename to normal_database.vnd and save into Templates folder of PAF Gait
! 

File_New
;

Set_Pipeline_Parameter_To_Folder_Path
/PARAMETER_NAME=path
! /PARAMETER_VALUE=VISUAL3D_DEFAULT_DATA_FOLDER
! /PARAMETER_VALUE_MOTION_FILE=
! /PARAMETER_VALUE_SEARCH_FOR=
! /PARAMETER_VALUE_REPLACE_WITH=
! /PARAMETER_VALUE_APPEND=
/SET_PROMPT=Select path to cmo files
;

Load_CMO_Library
!/TAG=
!/QUERY=
/CMO_LIBRARY_PATH=::path
;

Select_Active_File
/FILE_NAME=ALL_FILES
! /QUERY=
;

Select_Active_File
/FILE_NAME=Dynamic
! /QUERY=
;

Prompt_For_Pipeline_Parameter_Value
/PIPELINE_PARAMETER_NAME=UB_exists
/PROMPT=Does normative sample include upper body segments?
! /DATA_TYPE=
/DEFAULT_VALUE=Yes
/USE_POSSIBLE_VALUES=TRUE
/POSSIBLE_VALUES=Yes+No
! /USE_UNITS=FALSE
! /DEFAULT_UNITS=
! /USE_POSSIBLE_UNITS=FALSE
! /POSSIBLE_UNITS=
! /CONVERSIONS=
;

Prompt_For_Pipeline_Parameter_Value
/PIPELINE_PARAMETER_NAME=OFM_exists
/PROMPT=Does normative sample include Oxford Foot segments?
! /DATA_TYPE=
/DEFAULT_VALUE=No
/USE_POSSIBLE_VALUES=TRUE
/POSSIBLE_VALUES=Yes+No
! /USE_UNITS=FALSE
! /DEFAULT_UNITS=
! /USE_POSSIBLE_UNITS=FALSE
! /POSSIBLE_UNITS=
! /CONVERSIONS=
;

Global_Normalized_Signal_Mean
/SIGNAL_TYPES=LINK_MODEL_BASED
! /SIGNAL_FOLDER=ORIGINAL
/SIGNAL_NAMES=Left Pelvic Angles
/SIGNAL_COMPONENTS=X
! /COMPONENT_SEQUENCE=
! /START_LABEL=
! /END_LABEL=
/EVENT_SEQUENCE=LHS+LHS
/EXCLUDE_EVENTS=BAD9
/RESULT_FOLDER=PROCESSED
/RESULT_NAME=Left Pelvic Angles_X_LHS_LHS
