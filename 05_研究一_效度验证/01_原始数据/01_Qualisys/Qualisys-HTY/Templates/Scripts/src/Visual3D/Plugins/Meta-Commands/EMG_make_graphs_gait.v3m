! BEGIN_META
! META_CMD_NAME	= EMG_Make_Graphs_Gait
! META_PARAM	= page_number  :   string ::yes						
! META_PARAM	= first_EMG_page  :   string ::yes						
! META_PARAM	= last_EMG_page  :   string ::yes						
! META_PARAM	= EMG_names_array_left_exists  :   string ::yes						
! META_PARAM	= EMG_names_array_right_exists  :   string ::yes						
! META_PARAM	= EMG_graph_signals_name_left  :   string ::yes						
! META_PARAM	= EMG_graph_signals_name_right  :   string ::yes						
! META_PARAM	= count_EMG_signals_left  :   string ::yes						
! META_PARAM	= count_EMG_signals_right  :   string ::yes						
! META_PARAM	= add_test_condition_pre  :   string ::yes						
! META_PARAM	= test_condition  :   string ::yes						
! META_PARAM	= event_mode  :   string ::yes						
! META_PARAM	= analysis_name  :   string ::yes						
! META_PARAM	= c3d_files_count  :   string ::yes						
! META_PARAM	= noraxon_exists  :   string ::yes						
! META_PARAM	= normative_non_noraxon_file_exists  :   string ::yes						
! META_PARAM	= hide_messages  :   string ::yes						
! META_PARAM	= EMG_valid_names_list  :   string ::yes						
! META_PARAM	= p2d_signal_names_list  :   string ::yes						
! META_PARAM	= left_norm_event  :   string ::yes						
! META_PARAM	= right_norm_event  :   string ::yes						
! META_PARAM	= selected_files  :   string ::yes						
! META_PARAM	= sd_line_style  :   string ::yes						
! META_PARAM	= sd_line_bold  :   string ::yes						
! META_PARAM	= EMG_pages_nums_list  :   string ::yes						
! META_PARAM	= picturesDirectory  :   string ::yes						
! META_PARAM	= col_num  :   string ::yes						
! END_META

