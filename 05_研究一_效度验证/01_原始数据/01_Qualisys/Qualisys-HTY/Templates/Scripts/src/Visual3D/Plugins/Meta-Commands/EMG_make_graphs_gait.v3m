! Add empty picture to all rows without graph up to 4 rows to keep the size of graphs same for first and second page
Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=((&::row& - 1) < 4)
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter_From_For_Loop
	/PARAMETER_NAME=rows
	/PARAMETER_INDEX_START=&::row
	/PARAMETER_INDEX_END=4
	/PARAMETER_INDEX_STEP=1
	! /PARAMETER_INDEX_TYPE=INTEGER
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond1
	/EXPRESSION=((&::count_EMG_signals_left& > 4) | (&::count_EMG_signals_right& > 4))
	! /AS_INTEGER=TRUE
	;

		Set_Pipeline_Parameter_From_For_Loop
		/PARAMETER_NAME=EMG_pages_even
		/PARAMETER_INDEX_START=&::first_EMG_page& + 1
		/PARAMETER_INDEX_END=::last_EMG_page
		/PARAMETER_INDEX_STEP=2
		! /PARAMETER_INDEX_TYPE=INTEGER
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond1
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond1
	/EXPRESSION=((&::count_EMG_signals_left& < 4) &::AMP& (&::count_EMG_signals_right& < 4))
	! /AS_INTEGER=TRUE
	;

		Set_Pipeline_Parameter_From_For_Loop
		/PARAMETER_NAME=EMG_pages_even
		/PARAMETER_INDEX_START=&::first_EMG_page
		/PARAMETER_INDEX_END=::last_EMG_page
		/PARAMETER_INDEX_STEP=1
		! /PARAMETER_INDEX_TYPE=INTEGER
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond1
	;

	For_Each
	/ITERATION_PARAMETER_NAME=row
	! /ITERATION_PARAMETER_COUNT_NAME=
	/ITEMS=::rows
	;		

		For_Each
		/ITERATION_PARAMETER_NAME=p_num
		! /ITERATION_PARAMETER_COUNT_NAME=
		/ITEMS=::EMG_pages_even
		;		

			Make_Image_Item
			/IMAGE_FILE=&::picturesDirectory&EMG_dummy_placeholder.jpg
			/PAGE_NUMBER=::p_num
			/COLUMN_NUMBER=::col_num
			/ROW_NUMBER=::row
			! /COLUMN_SPAN=1
			! /ROW_SPAN=1
			;

		End_For_Each
		/ITERATION_PARAMETER_NAME=p_num
		;

	End_For_Each
	/ITERATION_PARAMETER_NAME=row
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;
