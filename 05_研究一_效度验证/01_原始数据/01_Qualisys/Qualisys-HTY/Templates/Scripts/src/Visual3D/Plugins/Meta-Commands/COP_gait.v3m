! BEGIN_META
! META_CMD_NAME	= COP_Gait
! META_PARAM	= event_mode  :   string ::yes						
! META_PARAM	= normative_directory  :   string ::yes						
! META_PARAM	= select_tags  :   string ::yes						
! META_PARAM	= COP_start_shift  :   string ::yes						
! END_META

