					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y)))
					
					
					  +(("&::wd&" = "Y_pos") + ("&::wd&" = "Y_neg"))
						*(((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y))
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y))
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y))
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 

					  
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y))
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y))

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::r_foot_outline::y)) 
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::r_foot_outline::y)))
			/RESULT_NAME=r_foot_outline_Y
			/RESULT_TYPE=P2D
			/RESULT_FOLDER=Feet_outlines
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Evaluate_Expression
		/EXPRESSION=vector(P2D::Feet_outlines::r_foot_outline_X, P2D::Feet_outlines::r_foot_outline_Y)
		/RESULT_NAME=r_foot_outline
		/RESULT_TYPE=P2D
		/RESULT_FOLDER=Feet_outlines
		;

		! shift COP start since calcaneus marker is 2 cm behind the actual bone
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=(("&::event_mode&" = "Single forceplate") | ("&::event_mode&" = "Instrumented treadmill (split belt)") | ("&::event_mode&" = "Instrumented treadmill (single belt)"))
		! /AS_INTEGER=TRUE
		;

			 Evaluate_Expression
			 /EXPRESSION=&::COP_start_shift&
			 /RESULT_NAME=HS_pos_shift
			 /RESULT_TYPE=METRIC
			 /RESULT_FOLDER=COP
			 ;
			 
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=(("&::event_mode&" <> "Single forceplate") &::AMP& ("&::event_mode&" <> "Instrumented treadmill (split belt)") &::AMP& ("&::event_mode&" <> "Instrumented treadmill (single belt)"))
		! /AS_INTEGER=TRUE
		;

			 Evaluate_Expression
			/EXPRESSION=((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)

					  
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)

					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)* -&::COP_start_shift&)
					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)* &::COP_start_shift&)
			/RESULT_NAME=HS_pos_shift
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=COP
			;
		 
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Add_Constant_To_Signals
		 /SIGNAL_TYPES=METRIC
		 /SIGNAL_FOLDER=COP
		 /SIGNAL_NAMES=L_FCC@LON
		 /RESULT_TYPES=METRIC
		 /RESULT_FOLDER=COP
		 /RESULT_NAMES=L_FCC@LON
		 ! /RESULT_SUFFIX=
		 /SIGNAL_COMPONENTS=X
		 /CONSTANT=METRIC::COP::HS_pos_shift
		 ;

		Add_Constant_To_Signals
		 /SIGNAL_TYPES=METRIC
		 /SIGNAL_FOLDER=COP
		 /SIGNAL_NAMES=R_FCC@RON
		 /RESULT_TYPES=METRIC
		 /RESULT_FOLDER=COP
		 /RESULT_NAMES=R_FCC@RON
		 ! /RESULT_SUFFIX=
		 /SIGNAL_COMPONENTS=X
		 /CONSTANT=METRIC::COP::HS_pos_shift
		 ;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" <> "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			! move outline to calcaneus position and rotate it to foot progression angle
			 Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((P2D::Feet_outlines::l_foot_outline::X * cos (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::l_foot_outline::Y * sin (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::L_FCC@LON::X))
			 /RESULT_NAME=L_foot_outline_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((- P2D::Feet_outlines::l_foot_outline::X * sin (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::l_foot_outline::Y * cos (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::L_FCC@LON::Y))
			 /RESULT_NAME=L_foot_outline_Y_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 /EXPRESSION=vector(DERIVED::COP::L_foot_outline_X_rot,DERIVED::COP::L_foot_outline_Y_rot)
			 /RESULT_NAME=L_foot_outline_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((P2D::Feet_outlines::r_foot_outline::X * cos (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::r_foot_outline::Y * sin (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::R_FCC@RON::X))
			 /RESULT_NAME=R_foot_outline_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((- P2D::Feet_outlines::r_foot_outline::X * sin (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::r_foot_outline::Y * cos (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::R_FCC@RON::Y))
			 /RESULT_NAME=R_foot_outline_Y_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 /EXPRESSION=vector(DERIVED::COP::R_foot_outline_X_rot,DERIVED::COP::R_foot_outline_Y_rot)
			 /RESULT_NAME=R_foot_outline_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;
			 
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" = "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((P2D::Feet_outlines::&::select_files&_foot_outline::X * cos (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::&::select_files&_foot_outline::Y * sin (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::&::select_files&_FCC@&::select_files&ON::X))
			 /RESULT_NAME=&::select_files&_foot_outline_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 !rotation and transposition
			 /EXPRESSION=((- P2D::Feet_outlines::&::select_files&_foot_outline::X * sin (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) + (P2D::Feet_outlines::&::select_files&_foot_outline::Y * cos (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) + (METRIC::COP::&::select_files&_FCC@&::select_files&ON::Y))
			 /RESULT_NAME=&::select_files&_foot_outline_Y_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 /EXPRESSION=vector(DERIVED::COP::&::select_files&_foot_outline_X_rot,DERIVED::COP::&::select_files&_foot_outline_Y_rot)
			 /RESULT_NAME=&::select_files&_foot_outline_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		!Place all COPs at one graph
		!==============================
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" <> "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			For_Each
			/ITERATION_PARAMETER_NAME=side
			/ITEMS=L+R
			;

				! zeroing COP to place them at same origin relative to foot outline
				! calculate distance of foot COG to proximal end of foot segment at L/RMS
				Metric_Signal_Value_At_Event
				/SIGNAL_TYPES=LINK_MODEL_BASED
				! /SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=&::side&_COP
				/RESULT_METRIC_FOLDER=COP
				/RESULT_METRIC_NAME=@&::side&MS
				/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
				! /SIGNAL_COMPONENTS=
				/COMPONENT_SEQUENCE=ALL
				/EVENT_NAME=&::side&MS
				! /GENERATE_MEAN_AND_STDDEV=TRUE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
				! /RETAIN_NO_DATA_VALUES=FALSE
				;

				Metric_Signal_Value_At_Event
				/RESULT_METRIC_NAME=&::side&_foot_CG_rt_LAB@&::side&MS
				! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
				/RESULT_METRIC_FOLDER=COP
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_NAMES=&::side&_foot_CG_rt_LAB
				! /SIGNAL_FOLDER=ORIGINAL
				! /SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				/EVENT_NAME=&::side&MS
				! /GENERATE_MEAN_AND_STDDEV=TRUE
				! /APPEND_TO_EXISTING_VALUES=FALSE
				! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
				! /RETAIN_NO_DATA_VALUES=FALSE
				;
				
				Conditional_Statement
				/ITERATION_PARAMETER_NAME=cond1
				/EXPRESSION=(("&::event_mode&" = "Instrumented treadmill (split belt)") | ("&::event_mode&" = "Instrumented treadmill (single belt)"))
				! /AS_INTEGER=TRUE
				;

					!compute COP within trial mean
					Global_Normalized_Signal_Mean
					/SIGNAL_TYPES=LINK_MODEL_BASED
					/SIGNAL_NAMES=&::side&_COP
					/SIGNAL_FOLDER=ORIGINAL
					! /SIGNAL_COMPONENTS=
					/COMPONENT_SEQUENCE=X
					! /START_LABEL=
					! /END_LABEL=
					/EVENT_SEQUENCE=&::side&ON+&::side&OFF
					! /EXCLUDE_EVENTS=
					/RESULT_NAME=&::side&_COP_mean_X
					/RESULT_FOLDER=COP
					! /NORMALIZE_POINTS=101
					/CREATE_STANDARD_DEVIATION=TRUE
					/CALCULATE_PER_FILE=TRUE
					;

					Global_Normalized_Signal_Mean
					/SIGNAL_TYPES=LINK_MODEL_BASED
					/SIGNAL_NAMES=&::side&_COP
					/SIGNAL_FOLDER=ORIGINAL
					! /SIGNAL_COMPONENTS=
					/COMPONENT_SEQUENCE=Y
					! /START_LABEL=
					! /END_LABEL=
					/EVENT_SEQUENCE=&::side&ON+&::side&OFF
					! /EXCLUDE_EVENTS=
					/RESULT_NAME=&::side&_COP_mean_Y
					/RESULT_FOLDER=COP
					! /NORMALIZE_POINTS=101
					/CREATE_STANDARD_DEVIATION=TRUE
					/CALCULATE_PER_FILE=TRUE
					;

					Global_Normalized_Signal_Mean
					/SIGNAL_TYPES=LINK_MODEL_BASED
					/SIGNAL_NAMES=&::side&_COP
					/SIGNAL_FOLDER=ORIGINAL
					! /SIGNAL_COMPONENTS=
					/COMPONENT_SEQUENCE=Z
					! /START_LABEL=
					! /END_LABEL=
					/EVENT_SEQUENCE=&::side&ON+&::side&OFF
					! /EXCLUDE_EVENTS=
					/RESULT_NAME=&::side&_COP_mean_Z
					/RESULT_FOLDER=COP
					! /NORMALIZE_POINTS=101
					/CREATE_STANDARD_DEVIATION=TRUE
					/CALCULATE_PER_FILE=TRUE
					;

					!correct COP by adding distance covered by treadmill
					! distance covered by treadmill in one frame
					Evaluate_Expression
					/EXPRESSION=METRIC::TREADMILL::SPEED / PARAMETERS::POINT::RATE
					/RESULT_NAME=DISPLACEMENT_PER_FRAME
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;

					!number of frames from L/RON to L/ROFF
					Metric_Frames_Between_Events
					/RESULT_METRIC_NAME=Frames_&::side&ON_to_&::side&OFF
					/RESULT_METRIC_FOLDER=COP
					/EVENT_SEQUENCE=&::side&ON& + &::side&OFF
					/EXCLUDE_EVENTS=
					/GENERATE_MEAN_AND_STDDEV=FALSE
					! /APPEND_TO_E XISTING_VALUES=FALSE
					;
					
					Metric_Mean
					/RESULT_METRIC_NAME=_mean
					/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
					/RESULT_METRIC_FOLDER=COP
					/SIGNAL_TYPES=METRIC
					/SIGNAL_NAMES=Frames_&::side&ON_to_&::side&OFF
					/SIGNAL_FOLDER=COP
					/SIGNAL_COMPONENTS=
					/COMPONENT_SEQUENCE=ALL
					/EVENT_SEQUENCE=
					/EXCLUDE_EVENTS=
					/GENERATE_MEAN_AND_STDDEV=FALSE
					! /APPEND_TO_EXISTING_VALUES=FALSE
					;
					
					!recalculate distance per frame to 101 frames since P2D::COP::L/RCOP_mean has 101 frames
					Evaluate_Expression
					/EXPRESSION=METRIC::COP::Frames_&::side&ON_to_&::side&OFF_mean / 101 * METRIC::COP::DISPLACEMENT_PER_FRAME
					/RESULT_NAME=DISPLACEMENT_PER_FRAME_rel
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;
					
					! add distance traveled by treadmill to COP coordinates (only x component so far)
					Evaluate_Expression
					/EXPRESSION=GLOBAL::P2D::COP::&::side&_COP_mean_X::Y + (METRIC::COP::DISPLACEMENT_PER_FRAME_rel * GLOBAL::P2D::COP::&::side&_COP_mean_X::X)
					/RESULT_NAME=&::side&_COP_mean_work
					/RESULT_TYPE=P2D
					/RESULT_FOLDER=COP
					;

					! recreate X component of P2D::COP::cop_mean_X
					Evaluate_Expression
					/EXPRESSION=vector(P2D::COP::&::side&_COP_mean_Y::X, P2D::COP::&::side&_COP_mean_work::X,GLOBAL::P2D::COP::&::side&_COP_mean_X::Z)
					/RESULT_NAME=&::side&_COP_mean_X
					/RESULT_TYPE=P2D
					/RESULT_FOLDER=COP
					;

					!delete temporary signal
					Remove_Signals
					/SIGNAL_TYPES=P2D
					/SIGNAL_NAMES=&::side&_COP_mean_work
					/SIGNAL_FOLDER=COP
					! /INCLUDE_MODELS=FALSE
					;

					! merge components to one signal
					Evaluate_Expression
					/EXPRESSION=vector(P2D::COP::&::side&_COP_mean_X::Y,P2D::COP::&::side&_COP_mean_Y::Y,P2D::COP::&::side&_COP_mean_Z::Y)
					/RESULT_NAME=&::side&_COP_mean
					! /RESULT_TYPE=DERIVED
					/RESULT_FOLDER=COP
					;
					
					! calculate mean midstance as pct of stance
					!first ensure same number of events
					Event_Copy
					/EVENT_NAME=&::side&HS
					/NEW_EVENT_NAME=&::side&HS_temp
					! /EVENT_INSTANCE=0
					! /RANGE_INSTANCE=0
					/EVENT_SEQUENCE=&::side&HS+&::side&TO
					! /EXCLUDE_EVENTS=
					! /START_AT_EVENT=
					! /END_AT_EVENT=
					/FRAME_OFFSET=0
					! /TIME_OFFSET=
					! /PERCENT_OFFSET=
					;
					
					Event_Copy
					/EVENT_NAME=&::side&MS
					/NEW_EVENT_NAME=&::side&MS_temp
					! /EVENT_INSTANCE=0
					! /RANGE_INSTANCE=0
					/EVENT_SEQUENCE=&::side&HS+&::side&TO
					! /EXCLUDE_EVENTS=
					! /START_AT_EVENT=
					! /END_AT_EVENT=
					/FRAME_OFFSET=0
					! /TIME_OFFSET=
					! /PERCENT_OFFSET=
					;
					
					Event_Copy
					/EVENT_NAME=&::side&TO
					/NEW_EVENT_NAME=&::side&TO_temp_1f
					! /EVENT_INSTANCE=0
					! /RANGE_INSTANCE=0
					!/EVENT_SEQUENCE=
					! /EXCLUDE_EVENTS=
					! /START_AT_EVENT=
					! /END_AT_EVENT=
					/FRAME_OFFSET=1
					! /TIME_OFFSET=
					! /PERCENT_OFFSET=
					;
					
					Event_Copy
					/EVENT_NAME=&::side&TO
					/NEW_EVENT_NAME=&::side&TO_temp
					! /EVENT_INSTANCE=0
					! /RANGE_INSTANCE=0
					/EVENT_SEQUENCE=&::side&HS+&::side&TO_temp_1f
					! /EXCLUDE_EVENTS=
					! /START_AT_EVENT=
					! /END_AT_EVENT=
					/FRAME_OFFSET=0
					! /TIME_OFFSET=
					! /PERCENT_OFFSET=
					;
					
					Metric_Time_Between_Events
					/RESULT_METRIC_NAME=&::side&_cycle_time
					/RESULT_METRIC_FOLDER=COP
					/EVENT_SEQUENCE=&::side&HS_temp+&::side&MS_temp+&::side&TO_temp
					/EXCLUDE_EVENTS=
					! /GENERATE_MEAN_AND_STDDEV=TRUE
					! /APPEND_TO_EXISTING_VALUES=FALSE
					;
					
					Metric_Time_Between_Events
					/RESULT_METRIC_NAME=&::side&HS_to_&::side&MS_time
					/RESULT_METRIC_FOLDER=COP
					/EVENT_SEQUENCE=&::side&HS_temp+&::side&MS_temp
					/EXCLUDE_EVENTS=
					! /GENERATE_MEAN_AND_STDDEV=TRUE
					! /APPEND_TO_EXISTING_VALUES=FALSE
					;
					
					Set_Pipeline_Parameter_From_Expression
					/PARAMETER_NAME=MS_frame
					/EXPRESSION=round(mean((METRIC::COP::&::side&HS_to_&::side&MS_time / METRIC::COP::&::side&_cycle_time) * 100))
					! /AS_INTEGER=TRUE
					;

					!position of COP_mean first frame @ L/RMS
					Evaluate_Expression
					/EXPRESSION=DERIVED::COP::&::side&_COP_mean[&::MS_frame&]
					/RESULT_NAME=&::side&_COP@&::side&MS
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;
					
					!calculate distance of foot COG to COP @ L/RMS
					Evaluate_Expression
					/EXPRESSION=METRIC::COP::&::side&_foot_CG_rt_LAB@&::side&MS_MEAN - METRIC::COP::&::side&_COP@&::side&MS_MEAN
					/RESULT_NAME=&::side&_foot_CG_to_&::side&_COP_dist
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;

					!calculate distance of calcaneus to foot COG at L/RMS
					Evaluate_Expression
					/EXPRESSION=METRIC::COP::&::side&_foot_CG_rt_LAB@&::side&MS_MEAN - METRIC::COP::&::side&_FCC@&::side&MS_MEAN
					/RESULT_NAME=&::side&_foot_CG_to_&::side&_FCC_dist
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;

					! zeroing COP
					Evaluate_Expression
					/EXPRESSION=DERIVED::COP::&::side&_COP_mean - METRIC::COP::&::side&_COP@&::side&MS
					/RESULT_NAME=&::side&_COP_zeroed
					! /RESULT_TYPE=DERIVED
					/RESULT_FOLDER=COP
					;

					!shift COP origin by difference of CG to COP_origin minus COP_origin to FCC
					Evaluate_Expression
					/EXPRESSION=DERIVED::COP::&::side&_COP_zeroed + (METRIC::COP::&::side&_foot_CG_to_&::side&_FCC_dist - METRIC::COP::&::side&_foot_CG_to_&::side&_COP_dist)
					/RESULT_NAME=&::side&_COP_shifted
					! /RESULT_TYPE=DERIVED
					/RESULT_FOLDER=COP
					;
					
				Conditional_Statement_End
				/ITERATION_PARAMETER_NAME=cond1
				;
		
				Conditional_Statement
				/ITERATION_PARAMETER_NAME=cond1
				/EXPRESSION=(("&::event_mode&" <> "Instrumented treadmill (split belt)") &::AMP& ("&::event_mode&" <> "Instrumented treadmill (single belt)"))
				! /AS_INTEGER=TRUE
				;

					Evaluate_Expression
					/EXPRESSION=METRIC::COP::&::side&_foot_CG_rt_LAB@&::side&MS - METRIC::COP::&::side&_COP@&::side&MS
					/RESULT_NAME=&::side&_foot_CG_to_&::side&_COP_dist
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;

					!calculate distance of calcaneus to foot COG at L/RMS
					Evaluate_Expression
					/EXPRESSION=METRIC::COP::&::side&_foot_CG_rt_LAB@&::side&MS - METRIC::COP::&::side&_FCC@&::side&MS
					/RESULT_NAME=&::side&_foot_CG_to_&::side&_FCC_dist
					/RESULT_TYPE=METRIC
					/RESULT_FOLDER=COP
					;

					!calculate difference between calcaneus position and COP origin
					Evaluate_Expression
					/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::&::side&_COP - METRIC::COP::&::side&_COP@&::side&MS
					/RESULT_NAME=&::side&_COP_zeroed
					! /RESULT_TYPE=DERIVED
					/RESULT_FOLDER=COP
					;

					!shift COP origin by difference of two above
					Evaluate_Expression
					/EXPRESSION=DERIVED::COP::&::side&_COP_zeroed + (METRIC::COP::&::side&_foot_CG_to_&::side&_FCC_dist - METRIC::COP::&::side&_foot_CG_to_&::side&_COP_dist)
					/RESULT_NAME=&::side&_COP_shifted
					! /RESULT_TYPE=DERIVED
					/RESULT_FOLDER=COP
					;
					
				Conditional_Statement_End
				/ITERATION_PARAMETER_NAME=cond1
				;
		
			End_For_Each
			/ITERATION_PARAMETER_NAME=side
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" = "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			Metric_Signal_Value_At_Event
			/RESULT_METRIC_NAME=&::select_files&_foot_CG_rt_LAB@&::select_files&MS
			! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
			/RESULT_METRIC_FOLDER=COP
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_NAMES=&::select_files&_foot_CG_rt_LAB
			! /SIGNAL_FOLDER=ORIGINAL
			! /SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_NAME=&::select_files&MS
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Metric_Signal_Value_At_Event
			/RESULT_METRIC_NAME=&::select_files&_COP@&::select_files&MS
			! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
			/RESULT_METRIC_FOLDER=COP
			/SIGNAL_TYPES=LINK_MODEL_BASED
			/SIGNAL_NAMES=&::select_files&_COP
			! /SIGNAL_FOLDER=ORIGINAL
			! /SIGNAL_COMPONENTS=
			! /COMPONENT_SEQUENCE=
			/EVENT_NAME=&::select_files&MS
			! /GENERATE_MEAN_AND_STDDEV=TRUE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			! /GENERATE_VECTOR_LENGTH_METRIC=FALSE
			! /RETAIN_NO_DATA_VALUES=FALSE
			;

			Evaluate_Expression
			/EXPRESSION=METRIC::COP::&::select_files&_foot_CG_rt_LAB@&::select_files&MS - METRIC::COP::&::select_files&_COP@&::select_files&MS
			/RESULT_NAME=&::select_files&_foot_CG_to_&::select_files&_COP_dist
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=COP
			;

			!calculate distance of calcaneus to foot COG at L/RON
			Evaluate_Expression
			/EXPRESSION=METRIC::COP::&::select_files&_foot_CG_rt_LAB@&::select_files&MS - METRIC::COP::&::select_files&_FCC@&::select_files&MS
			/RESULT_NAME=&::select_files&_foot_CG_to_&::select_files&_FCC_dist
			/RESULT_TYPE=METRIC
			/RESULT_FOLDER=COP
			;

			!calculate difference between calcaneus position and COP origin
			Evaluate_Expression
			/EXPRESSION=LINK_MODEL_BASED::ORIGINAL::&::select_files&_COP - METRIC::COP::&::select_files&_COP@&::select_files&MS
			/RESULT_NAME=&::select_files&_COP_zeroed
			! /RESULT_TYPE=DERIVED
			/RESULT_FOLDER=COP
			;
			 
			!shift COP origin by difference of two above
			Evaluate_Expression
			/EXPRESSION=DERIVED::COP::&::select_files&_COP_zeroed + (METRIC::COP::&::select_files&_foot_CG_to_&::select_files&_FCC_dist - METRIC::COP::&::select_files&_foot_CG_to_&::select_files&_COP_dist)
			/RESULT_NAME=&::select_files&_COP_shifted
			! /RESULT_TYPE=DERIVED
			/RESULT_FOLDER=COP
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" <> "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			! rotate COP (without transpositioning)
			 Evaluate_Expression
			 /EXPRESSION=((DERIVED::COP::L_COP_shifted::X * cos (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) - (DERIVED::COP::L_COP_shifted::Y * sin (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)))
			 /RESULT_NAME=L_COP_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			/EXPRESSION=((DERIVED::COP::L_COP_shifted::X * sin (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)) + (DERIVED::COP::L_COP_shifted::Y * cos (METRIC::COP::L_Foot_Prog@opositeHS_rad::Z)))
			/RESULT_NAME=L_COP_Y_rot
			! /RESULT_TYPE=DERIVED
			/RESULT_FOLDER=COP
			;

			! invert if walking direction = -X/-Y
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=(("&::event_mode&" = "Instrumented treadmill (split belt)") | ("&::event_mode&" = "Instrumented treadmill (single belt)"))
			! /AS_INTEGER=TRUE
			;

				Evaluate_Expression
				/EXPRESSION=vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)
				 /RESULT_NAME=L_COP_rot
				 ! /RESULT_TYPE=DERIVED
				 /RESULT_FOLDER=COP
				 ;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;
		
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=(("&::event_mode&" <> "Instrumented treadmill (split belt)") &::AMP& ("&::event_mode&" <> "Instrumented treadmill (single belt)"))
			! /AS_INTEGER=TRUE
			;

				Evaluate_Expression
				/EXPRESSION=(("&::wd&" = "X_pos") + ("&::wd&" = "X_neg"))
						* (((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot))))
						   
						+ (("&::wd&" = "Y_pos") + ("&::wd&" = "Y_neg"))
							* (((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot)))
						   + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::L_COP_X_rot,DERIVED::COP::L_COP_Y_rot))))
				 /RESULT_NAME=L_COP_rot
				 ! /RESULT_TYPE=DERIVED
				 /RESULT_FOLDER=COP
				 ;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;
		
			Evaluate_Expression
			 /EXPRESSION=((DERIVED::COP::R_COP_shifted::X * cos (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) - (DERIVED::COP::R_COP_shifted::Y * sin (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)))
			 /RESULT_NAME=R_COP_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			 /EXPRESSION=((DERIVED::COP::R_COP_shifted::X * sin (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)) + (DERIVED::COP::R_COP_shifted::Y * cos (METRIC::COP::R_Foot_Prog@opositeHS_rad::Z)))
			 /RESULT_NAME=R_COP_Y_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=(("&::event_mode&" = "Instrumented treadmill (split belt)") | ("&::event_mode&" = "Instrumented treadmill (single belt)"))
			! /AS_INTEGER=TRUE
			;

				Evaluate_Expression
				/EXPRESSION=vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)
				/RESULT_NAME=R_COP_rot
				! /RESULT_TYPE=DERIVED
				/RESULT_FOLDER=COP
				;

			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;
		
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=(("&::event_mode&" <> "Instrumented treadmill (split belt)") &::AMP& ("&::event_mode&" <> "Instrumented treadmill (single belt)"))
			! /AS_INTEGER=TRUE
			;

				Evaluate_Expression
			   /EXPRESSION=(("&::wd&" = "X_pos") + ("&::wd&" = "X_neg"))
						* (((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X > 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X < METRIC::COP::R_FCC@RON::X)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X > 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot))))

						 + (("&::wd&" = "Y_pos") + ("&::wd&" = "Y_neg"))
						* (((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot)))
						 + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y > 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-1 * vector(DERIVED::COP::R_COP_X_rot,DERIVED::COP::R_COP_Y_rot))))
				 /RESULT_NAME=R_COP_rot
				 ! /RESULT_TYPE=DERIVED
				 /RESULT_FOLDER=COP
				 ;
				 
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::event_mode&" = "Single forceplate")
		! /AS_INTEGER=TRUE
		;

			! rotate COP (without transpositioning)
			 Evaluate_Expression
			 /EXPRESSION=((DERIVED::COP::&::select_files&_COP_shifted::X * cos (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) - (DERIVED::COP::&::select_files&_COP_shifted::Y * sin (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)))
			 /RESULT_NAME=&::select_files&_COP_X_rot
			 ! /RESULT_TYPE=DERIVED
			 /RESULT_FOLDER=COP
			 ;

			Evaluate_Expression
			/EXPRESSION=((DERIVED::COP::&::select_files&_COP_shifted::X * sin (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)) + (DERIVED::COP::&::select_files&_COP_shifted::Y * cos (METRIC::COP::&::select_files&_Foot_Prog@opositeHS_rad::Z)))
			/RESULT_NAME=&::select_files&_COP_Y_rot
			! /RESULT_TYPE=DERIVED
			/RESULT_FOLDER=COP
			;

			! invert if walking direction = -X
			Evaluate_Expression
			/EXPRESSION=((METRIC::VIRTUAL_LAB::LAB_LATERAL::X = 0) * (vector(DERIVED::COP::&::select_files&_COP_X_rot,DERIVED::COP::&::select_files&_COP_Y_rot)))
					  + ((METRIC::VIRTUAL_LAB::LAB_LATERAL::Y = 0) * (-1 * vector(DERIVED::COP::&::select_files&_COP_X_rot,DERIVED::COP::&::select_files&_COP_Y_rot)))
			/RESULT_NAME=&::select_files&_COP_rot
			! /RESULT_TYPE=DERIVED
			/RESULT_FOLDER=COP
			;

		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;
		
	End_For_Each
	/ITERATION_PARAMETER_NAME=filename
	;

End_For_Each
/ITERATION_PARAMETER_NAME=select_files
;
