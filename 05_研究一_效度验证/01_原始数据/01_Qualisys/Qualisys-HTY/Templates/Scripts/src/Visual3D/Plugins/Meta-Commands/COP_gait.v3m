					  + ((METRIC::COP::LON > METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::X < 0)*(METRIC::COP::R_FCC@RON::X < 0)*(METRIC::COP::L_FCC@LON::X > METRIC::COP::R_FCC@RON::X)*(GLOBAL::P2D::Feet_outlines::l_foot_outline::y)))

					  + (("&::wd&" = "Y_pos") + ("&::wd&" = "Y_neg"))
					  * (((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::l_foot_outline::y))
					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y > 0)*(METRIC::COP::L_FCC@LON::Y > METRIC::COP::R_FCC@RON::Y)*(-GLOBAL::P2D::Feet_outlines::l_foot_outline::y))

					  + ((METRIC::COP::LON < METRIC::COP::RON)*(METRIC::COP::L_FCC@LON::Y < 0)*(METRIC::COP::R_FCC@RON::Y < 0)*(METRIC::COP::L_FCC@LON::Y < METRIC::COP::R_FCC@RON::Y)*(GLOBAL::P2D::Feet_outlines::l_foot_outline::y))
