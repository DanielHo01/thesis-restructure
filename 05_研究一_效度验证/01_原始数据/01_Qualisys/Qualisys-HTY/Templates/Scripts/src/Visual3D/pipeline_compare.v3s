	file_put_contents($working_directory . 'metrics_EMG_pre.xml', $fileContent);
}

$post_cmo_file = $working_directory_array[4];
$pre_cmo_directory = $working_directory_array[1];
$pre_cmo_file = $working_directory_array[3];

//store meta_pre.xml and meta.xml data to string/arrays
$xml = $working_directory . 'meta_pre.xml';
$meta_pre = simplexml_load_file($xml);
$EMG_pre_exists = (string) $meta_pre->includes_EMG;

$xml = $working_directory . 'meta.xml';
$meta_post = simplexml_load_file($xml);
$EMG_post_exists = (string) $meta_post->includes_EMG;

$xml = $working_directory . 'session_pre.xml';
$session_pre = simplexml_load_file($xml);
$test_condition_pre = (string) $session_pre->Session->Subsession->Fields->Test_condition;

// Include php variables.
include_once($v3dScriptDirectory . 'prepare_variables.php');
?> 

