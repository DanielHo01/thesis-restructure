exec('"' . $v3dScriptDirectory. 'FolderSelector.exe" "'. $wd . '" ' . $file_mask);

$working_directory_array = file($working_directory . 'comparison_folders.txt', FILE_IGNORE_NEW_LINES);

// copy session.xml and meta.xml from pre folder to post folder and rename it to *_pre.xml
// copy xml files from pre folder to post folder and rename them to *_pre.xml
$fileContent = file_get_contents($working_directory_array[1] . '\session.xml');
file_put_contents($working_directory . 'session_pre.xml', $fileContent);

