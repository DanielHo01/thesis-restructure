//Load recalc pipeline (joint angles, moments, power) from text file
if ($EMG_pre_exists == "no")
	echo "!No EMG data in PRE session\n";

if ($EMG_post_exists == "no")
	echo "!No EMG data in POST session\n";

if ($EMG_pre_exists == "yes" || $EMG_post_exists == "yes") {
	ob_start();
	include($v3dScriptDirectory . 'recalc.v3s');
	$recalc_pipeline =  ob_get_contents();
	ob_end_clean();
}

file_put_contents($working_directory . 'recalc.v3s', $recalc_pipeline);
?> 

