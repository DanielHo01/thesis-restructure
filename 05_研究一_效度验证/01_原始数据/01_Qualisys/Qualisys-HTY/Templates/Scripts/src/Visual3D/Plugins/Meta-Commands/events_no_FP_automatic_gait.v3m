Set_Pipeline_Parameter
/PARAMETER_NAME=r_heel_marker
/PARAMETER_VALUE=R_FCC
;

Set_Pipeline_Parameter
/PARAMETER_NAME=l_heel_marker
/PARAMETER_VALUE=L_FCC
;

Set_Pipeline_Parameter
/PARAMETER_NAME=r_toe_marker
/PARAMETER_VALUE=R_FM2
;

Set_Pipeline_Parameter
/PARAMETER_NAME=l_toe_marker
/PARAMETER_VALUE=L_FM2
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::model_used&" = "IOR") &::AMP& ("&::includes_OFM&" = "FALSE"))
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=r_toe_marker
	/PARAMETER_VALUE=R_FM1
	;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=l_toe_marker
	/PARAMETER_VALUE=L_FM1
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

Compute_Model_Based_Data
/RESULT_NAME=RHEEL_IN_PELVIS
/FUNCTION=TARGET_PATH
/SEGMENT=::r_heel_marker
/REFERENCE_SEGMENT=RPV
/RESOLUTION_COORDINATE_SYSTEM=RPV
