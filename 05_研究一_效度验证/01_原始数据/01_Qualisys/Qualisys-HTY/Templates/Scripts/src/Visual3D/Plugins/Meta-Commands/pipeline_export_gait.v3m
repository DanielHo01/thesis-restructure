				! /CREATE_STANDARD_DEVIATION=FALSE
				! /CALCULATE_PER_FILE=FALSE
				;

				! copy EMG signals to folder being exported to timeseries.xml
				Evaluate_Expression
				/EXPRESSION=(GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::emg&:&:&Y)
				/RESULT_NAME=::emg
				/RESULT_TYPE=ANALOG
				/RESULT_FOLDER=EMG_PROCESSED
