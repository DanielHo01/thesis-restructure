/RESULT_METRIC_NAME=LDblSuppMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=LDblSuppSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_StdDev
;

!Non-standard temporal metrics

!Speed in meters per min
Multiply_Signals_By_Constant
/SIGNAL_TYPES=METRIC
/SIGNAL_NAMES=Speed
/SIGNAL_FOLDER=TMPD
! /RESULT_TYPES=
/RESULT_FOLDER=SHORT
/RESULT_NAME=_m_per_minMean
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
! /SIGNAL_COMPONENTS=
/CONSTANT=60
;

!Strides per minute (mean of L+R sides)
Evaluate_Expression
/EXPRESSION=(GLOBAL::METRIC::TMPD::Left_Strides_Per_Minute_Mean+GLOBAL::METRIC::TMPD::Right_Strides_Per_Minute_Mean)/2
/RESULT_NAME=StrideMinMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=(GLOBAL::METRIC::TMPD::Left_Strides_Per_Minute_StdDev+GLOBAL::METRIC::TMPD::Right_Strides_Per_Minute_StdDev)/2
/RESULT_NAME=StrideMinSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Left_Strides_Per_Minute_Count+GLOBAL::METRIC::TMPD::Right_Strides_Per_Minute_Count
/RESULT_NAME=StrideMinCount
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

!Stride time in sec
Evaluate_Expression
/EXPRESSION=1/GLOBAL::METRIC::SHORT::StrideMinMean * 60
/RESULT_NAME=StriTimeMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

!Stance time as %gait cycle
Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Right_Stance_Time_Pct_Mean
/RESULT_NAME=RStanPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Right_Stance_Time_Pct_StdDev
/RESULT_NAME=RStanPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Left_Stance_Time_Pct_Mean
/RESULT_NAME=LStanPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Left_Stance_Time_Pct_StdDev
/RESULT_NAME=LStanPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Metric_Explicit
/RESULT_METRIC_NAME=RStanPctCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Stance_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=LStanPctCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Stance_Time_Count
;

!Swing time as %gait cycle
Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::RSwingTimeMean/GLOBAL::METRIC::TMPD::Right_Cycle_Time_Mean*100
/RESULT_NAME=RSwingPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::RSwingTimeSD/GLOBAL::METRIC::TMPD::Right_Cycle_Time_Mean*100
/RESULT_NAME=RSwingPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::LSwingTimeMean/GLOBAL::METRIC::TMPD::Left_Cycle_Time_Mean*100
/RESULT_NAME=LSwingPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::LSwingTimeSD/GLOBAL::METRIC::TMPD::Left_Cycle_Time_Mean*100
/RESULT_NAME=LSwingPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

!Double Support as %gait cycle
Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::RDblSuppMean/GLOBAL::METRIC::TMPD::Right_Cycle_Time_Mean*100
/RESULT_NAME=RDblSuppPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::RDblSuppSD/GLOBAL::METRIC::TMPD::Right_Cycle_Time_Mean*100
/RESULT_NAME=RDblSuppPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::LDblSuppMean/GLOBAL::METRIC::TMPD::Left_Cycle_Time_Mean*100
/RESULT_NAME=LDblSuppPctMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SHORT::LDblSuppSD/GLOBAL::METRIC::TMPD::Left_Cycle_Time_Mean*100
/RESULT_NAME=LDblSuppPctSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

!Cadence as sum of right steps per minute + left steps per minute
Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Cadence_Count
/RESULT_NAME=CadenceCount
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Cadence_Mean
/RESULT_NAME=CadenceMean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Cadence_StdDev
/RESULT_NAME=CadenceSD
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SHORT
;

! For_Each
! /ITERATION_PARAMETER_NAME=tag_name
! /ITERATION_PARAMETER_COUNT_NAME=inc
! /ITEMS=::select_tags_arr_list
! ;

	! Get_Pipeline_Parameter_Index_Value
	! /PARAMETER_NAME=file
	! /PARAMETER_VALUE=::select_tags_list
	! /INDEX=::inc
	! ;
	
	Select_Active_File
	/FILE_NAME=Dynamic
	!/FILE_NAME=::file
	! /QUERY=
	;

	! Set_Pipeline_Parameter_From_Expression
	! /PARAMETER_NAME=str
	! /EXPRESSION=STRING_LENGTH("&::link_signal_names&") -19
	! ! /AS_INTEGER=TRUE
	! ;

	! Set_Pipeline_Parameter_From_Expression
	! /PARAMETER_NAME=str
	! /EXPRESSION=STRING_LENGTH("&::event_seq&") -19
	! ! /AS_INTEGER=TRUE
	! ;

	! Conditional_Statement
	! /ITERATION_PARAMETER_NAME=cond
	! /EXPRESSION=("&::tag_name&" = "Left")
	! ! /AS_INTEGER=TRUE
	! ;

		! Set_Pipeline_Parameter_From_Expression
		! /PARAMETER_NAME=link_signal_names_wo_grf
		! /EXPRESSION=STRING_RIGHT("&::link_signal_names&", &::str&)
		! ! /AS_INTEGER=TRUE
		! ;

		! Set_Pipeline_Parameter_From_Expression
		! /PARAMETER_NAME=link_signal_names_wo_grf
		! /EXPRESSION=STRING_RIGHT("&::link_signal_names&", &::str&)
		! ! /AS_INTEGER=TRUE
		! ;

	! Conditional_Statement_End
	! /ITERATION_PARAMETER_NAME=cond
	! ;
	
	! Conditional_Statement
	! /ITERATION_PARAMETER_NAME=cond
	! /EXPRESSION=("&::tag_name&" = "Right")
	! ! /AS_INTEGER=TRUE
	! ;

		! Set_Pipeline_Parameter
		! /PARAMETER_NAME=link_signal_names_wo_grf
		! /PARAMETER_VALUE=::link_signal_names
		! /PARAMETER_VALUE_SEARCH_FOR=Left GRF+Right GRF
		! /PARAMETER_VALUE_REPLACE_WITH=Right GRF
		! ! /PARAMETER_VALUE_PREFIX=
		! ! /PARAMETER_VALUE_APPEND=
		! ! /MULTI_PASS=FALSE
		! ;

	! Conditional_Statement_End
	! /ITERATION_PARAMETER_NAME=cond
	! ;

	! Set_Pipeline_Parameter
	! /PARAMETER_NAME=link_signal_names_wo_grf
	! /PARAMETER_VALUE=::link_signal_names_wo_grf
	! /PARAMETER_VALUE_SEARCH_FOR=++
	! /PARAMETER_VALUE_REPLACE_WITH=+
	! ! /PARAMETER_VALUE_PREFIX=
	! ! /PARAMETER_VALUE_APPEND=
	! ! /MULTI_PASS=FALSE
	! ;

	!Maximum and minimum for link model based data. Needed for adjustment of y range of Word plots.
	For_Each
	/ITERATION_PARAMETER_NAME=component
	! /ITERATION_PARAMETER_COUNT_NAME=
	/ITEMS=X+Y+Z
	;
		Metric_Maximum
		/RESULT_METRIC_NAME=_max_&::component
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/RESULT_METRIC_FOLDER=MIN_MAX
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_NAMES=::link_signal_names
		! /SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_COMPONENTS=
		/COMPONENT_SEQUENCE=&::component
		/EVENT_SEQUENCE=::event_seq
		/EXCLUDE_EVENTS=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		/CREATE_GLOBAL_MAXIMUM=TRUE
		;
	
		Metric_Minimum
		/RESULT_METRIC_NAME=_min_&::component
		/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
		/RESULT_METRIC_FOLDER=MIN_MAX
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_NAMES=::link_signal_names
		! /SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_COMPONENTS=
		/COMPONENT_SEQUENCE=&::component
		/EVENT_SEQUENCE=::event_seq
		/EXCLUDE_EVENTS=
		/GENERATE_MEAN_AND_STDDEV=FALSE
		! /APPEND_TO_EXISTING_VALUES=FALSE
		/CREATE_GLOBAL_MINIMUM=TRUE
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond
		/EXPRESSION=("&::includes_OFM&" = "TRUE")
		! /AS_INTEGER=TRUE
		;

			Metric_Maximum
			/RESULT_METRIC_NAME=_max_X
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/RESULT_METRIC_FOLDER=MIN_MAX
			/SIGNAL_TYPES=DERIVED+DERIVED
			/SIGNAL_NAMES=Left Arch Height+Right Arch Height
			/SIGNAL_FOLDER=ARCH_HEIGHT+ARCH_HEIGHT
			/SIGNAL_COMPONENTS=
			/COMPONENT_SEQUENCE=X
			/EVENT_SEQUENCE=LHS+LHS,RHS+RHS
			/EXCLUDE_EVENTS=
			/GENERATE_MEAN_AND_STDDEV=FALSE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			/CREATE_GLOBAL_MAXIMUM=TRUE
			;

			Metric_Minimum
			/RESULT_METRIC_NAME=_min_X
			/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
			/RESULT_METRIC_FOLDER=MIN_MAX
			/SIGNAL_TYPES=DERIVED+DERIVED
			/SIGNAL_NAMES=Left Arch Height+Right Arch Height
			/SIGNAL_FOLDER=ARCH_HEIGHT+ARCH_HEIGHT
			/SIGNAL_COMPONENTS=
			/COMPONENT_SEQUENCE=X
			/EVENT_SEQUENCE=LHS+LHS,RHS+RHS
			/EXCLUDE_EVENTS=
			/GENERATE_MEAN_AND_STDDEV=FALSE
			! /APPEND_TO_EXISTING_VALUES=FALSE
			/CREATE_GLOBAL_MINIMUM=TRUE
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond
		;

	End_For_Each
	/ITERATION_PARAMETER_NAME=component
	;
	
! End_For_Each
! /ITERATION_PARAMETER_NAME=tag_name
! ;

!========================================
!Determine number of dynamic files
!========================================

Set_Pipeline_Parameter_To_List_Of_Files
/PARAMETER_NAME=FILE_LIST
/FOLDER=::working_directory
! /SEARCH_SUBFOLDERS=FALSE
/FILE_MASK=Gait*.c3d
;

Select_Active_File 
/FILE_NAME=GLOBAL 
;

Metric_Explicit
/RESULT_METRIC_NAME=NUM_FILES
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=0
;

For_Each
/ITERATION_PARAMETER_NAME=FILE_NAME
/ITEMS=::FILE_LIST
;

	Add_Constant_To_Signals
	/SIGNAL_TYPES=METRIC
	/SIGNAL_NAMES=NUM_FILES
	/SIGNAL_FOLDER=TMPD
	/RESULT_NAMES=GLOBAL::NUM_FILES
	/RESULT_TYPES=METRIC
	/RESULT_FOLDER=TMPD
	! /RESULT_SUFFIX=
	/SIGNAL_COMPONENTS=0
	/CONSTANT=1
	;

End_For_Each
/ITERATION_PARAMETER_NAME=FILE_NAME
;

!====================================
!Calculate event times as % so that intermediate events can be included in the plots:
!       Left:  Right:
!   0%  LHS    RHS
!       RTO    LTO
!       RHS    LHS
!       LTO    RTO
! 100%  LHS    RHS
!====================================

Select_Active_File 
/FILE_NAME=Dynamic 
;

!Left Side
Metric_Time_Between_Events
/RESULT_METRIC_NAME=LHS_to_LHS
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=LHS+LHS
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=LHS_to_RTO
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=LHS+RTO
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=LHS_to_RHS
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=LHS+RHS
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=LHS_to_LTO
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=LHS+LTO
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

!Express time between events as % Gait Cycle
Divide_Signal_By_Constant
/SIGNAL_TYPES=METRIC+METRIC+METRIC
/SIGNAL_NAMES=LHS_to_LTO+LHS_to_RHS+LHS_to_RTO
/SIGNAL_FOLDER=EVENTS_NORMALISED+EVENTS_NORMALISED+EVENTS_NORMALISED
! /RESULT_TYPES=
/RESULT_FOLDER=EVENTS_NORMALISED
/RESULT_NAME=_pct
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
! /SIGNAL_COMPONENTS=
/CONSTANT=METRIC::EVENTS_NORMALISED::LHS_to_LHS_MEAN
;

!Normalise LHS_to_RTO separately 
!Subtract 1 in case the result would otherwise be > 1
Evaluate_Expression
/EXPRESSION=(METRIC::EVENTS_NORMALISED::LHS_to_RTO/METRIC::EVENTS_NORMALISED::LHS_to_LHS_MEAN)-( 1 < (METRIC::EVENTS_NORMALISED::LHS_to_RTO/METRIC::EVENTS_NORMALISED::LHS_to_LHS_MEAN))
/RESULT_NAME=LHS_to_RTO_pct
/RESULT_TYPE=METRIC
/RESULT_FOLDER=EVENTS_NORMALISED
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=RHS_to_RHS
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=RHS+RHS
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=RHS_to_LTO
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=RHS+LTO
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=RHS_to_LHS
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=RHS+LHS
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_Time_Between_Events
/RESULT_METRIC_NAME=RHS_to_RTO
/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
/EVENT_SEQUENCE=RHS+RTO
/EXCLUDE_EVENTS=
/GENERATE_MEAN_AND_STDDEV=FALSE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

!Express time between events as % Gait Cycle
Divide_Signal_By_Constant
/SIGNAL_TYPES=METRIC+METRIC+METRIC
/SIGNAL_NAMES=RHS_to_RTO+RHS_to_LHS+RHS_to_LTO
/SIGNAL_FOLDER=EVENTS_NORMALISED+EVENTS_NORMALISED+EVENTS_NORMALISED
! /RESULT_TYPES=
/RESULT_FOLDER=EVENTS_NORMALISED
/RESULT_NAME=_pct
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
! /SIGNAL_COMPONENTS=
/CONSTANT=METRIC::EVENTS_NORMALISED::RHS_to_RHS_MEAN
;

!Normalise RHS_to_LTO separately 
!Subtract 1 in case the result would otherwise be > 1
Evaluate_Expression
/EXPRESSION=(METRIC::EVENTS_NORMALISED::RHS_to_LTO/METRIC::EVENTS_NORMALISED::RHS_to_RHS_MEAN)-( 1 < (METRIC::EVENTS_NORMALISED::RHS_to_LTO/METRIC::EVENTS_NORMALISED::RHS_to_RHS_MEAN))
/RESULT_NAME=RHS_to_LTO_pct
/RESULT_TYPE=METRIC
/RESULT_FOLDER=EVENTS_NORMALISED
;

! compute mean values
Select_Active_File
/FILE_NAME=Dynamic
! /QUERY=
;

!Calculate mean events (pct)
For_Each
/ITERATION_PARAMETER_NAME=SIG_NAME
/ITEMS=
RHS_to_LTO_pct+RHS_to_LHS_pct+RHS_to_RTO_pct+
LHS_to_RTO_pct+LHS_to_RHS_pct+LHS_to_LTO_pct
;

	!Within-trial mean
	Metric_Mean
	/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
	/RESULT_METRIC_NAME=_MEAN
	/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
	/SIGNAL_TYPES=METRIC
	/SIGNAL_FOLDER=EVENTS_NORMALISED
	/SIGNAL_NAMES=::SIG_NAME
	/COMPONENT_SEQUENCE=ALL
	/EVENT_SEQUENCE=
	/EXCLUDE_EVENTS=
	/SEQUENCE_PERCENT_START=
	/SEQUENCE_PERCENT_END=
	/GENERATE_MEAN_AND_STDDEV=FALSE
	! /APPEND_TO_EXISTING_VALUES=FALSE
	;


	!Global means (across all trials)
	Metric_Mean
	/RESULT_METRIC_NAME=GLOBAL::&::SIG_NAME
	! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
	/RESULT_METRIC_FOLDER=EVENTS_NORMALISED
	/SIGNAL_TYPES=METRIC
	/SIGNAL_NAMES=::SIG_NAME
	/SIGNAL_FOLDER=EVENTS_NORMALISED
	! /SIGNAL_COMPONENTS=ALL_COMPONENTS
	/EVENT_SEQUENCE=
	/EXCLUDE_EVENTS=
	/GENERATE_MEAN_AND_STDDEV=TRUE
	/APPEND_TO_EXISTING_VALUES=TRUE
	;


End_For_Each
/ITERATION_PARAMETER_NAME=SIG_NAME
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;


!====================================
!Prepare global means of all signals
!====================================

Select_Active_File 
/FILE_NAME=Dynamic
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=("&::includes_OFM&" = "TRUE")
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=link_signal_names
	/PARAMETER_VALUE=&::link_signal_names&+Left Arch Height+Right Arch Height
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=("&::includes_RFM&" = "TRUE")
! /AS_INTEGER=TRUE
;

	Set_Pipeline_Parameter
	/PARAMETER_NAME=link_signal_names
	/PARAMETER_VALUE=&::link_signal_names&+Left F2G+Left F2Ps+Left F2Pt+Left MLA+Left S2F+Left S2G+Left S2V+Left ShaCal_Static+Left V2G+Right F2G+Right F2Ps+Right F2Pt+Right MLA+Right S2F+Right S2G+Right S2V+Right ShaCal_Static+Right V2G
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

For_Each
/ITERATION_PARAMETER_NAME=signal
/ITEMS=::link_signal_names
;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(((STRING_FIND("&::signal&","Moment",0) <> -1) | (STRING_FIND("&::signal&","Power",0) <> -1)) &::AMP& ("&::event_mode&" = "Instrumented treadmill (single belt)"))
	! /AS_INTEGER=TRUE
	;

		Set_Data_To_New_Values
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=ORIGINAL
		/SIGNAL_NAMES=::signal
		! /SIGNAL_COMPONENTS=ALL_COMPONENTS
		! /RESULT_TYPES=
		! /RESULT_FOLDERS=PROCESSED
		! /RESULT_SUFFIX=
		/EVENT_SEQUENCE=LHS+RTO
		! /EXCLUDE_EVENTS=
		! /START_FRAME=
		! /END_FRAME=
		! /USE_POINT_RATE=TRUE
		! /REPLACEMENT_VALUES=NO_DATA
		! /THRESHOLD_HIGH=NO_DATA
		! /THRESHOLD_LOW=NO_DATA
		! /SET_DATA_AT_SINGLE_EVENT=FALSE
		;
		
		Set_Data_To_New_Values
		/SIGNAL_TYPES=LINK_MODEL_BASED
		/SIGNAL_FOLDER=PROCESSED
		/SIGNAL_NAMES=::signal
		! /SIGNAL_COMPONENTS=ALL_COMPONENTS
		! /RESULT_TYPES=
		! /RESULT_FOLDERS=PROCESSED
		! /RESULT_SUFFIX=
		/EVENT_SEQUENCE=RHS+LTO
		! /EXCLUDE_EVENTS=
		! /START_FRAME=
		! /END_FRAME=
		! /USE_POINT_RATE=TRUE
		! /REPLACEMENT_VALUES=NO_DATA
		! /THRESHOLD_HIGH=NO_DATA
		! /THRESHOLD_LOW=NO_DATA
		! /SET_DATA_AT_SINGLE_EVENT=FALSE
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	!define folder and type
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(STRING_FIND("&::signal&","Arch Height",0) <> -1)
	! /AS_INTEGER=TRUE
	;
	
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_type
		/PARAMETER_VALUE=DERIVED
		;
		
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_folder
		/PARAMETER_VALUE=ARCH_HEIGHT
		;
		
	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(STRING_FIND("&::signal&","GRF",0) <> -1)
	! /AS_INTEGER=TRUE
	;
	
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_type
		/PARAMETER_VALUE=DERIVED
		;
		
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_folder
		/PARAMETER_VALUE=FORCE_GRAPH
		;
		
	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=((STRING_FIND("&::signal&","F2",0) <> -1) | (STRING_FIND("&::signal&","MLA",0) <> -1) | (STRING_FIND("&::signal&","S2",0) <> -1) |  (STRING_FIND("&::signal&","ShaCal",0) <> -1) |  (STRING_FIND("&::signal&","V2G",0) <> -1))
	! /AS_INTEGER=TRUE
	;
	
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_type
		/PARAMETER_VALUE=DERIVED
		;
		
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_folder
		/PARAMETER_VALUE=RIZZOLI
		;
		
	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=((STRING_FIND("&::signal&","Arch Height",0) = -1) &::AMP& (STRING_FIND("&::signal&","GRF",0) = -1) &::AMP& (STRING_FIND("&::signal&","F2",0) = -1) &::AMP&  (STRING_FIND("&::signal&","MLA",0) = -1) &::AMP&  (STRING_FIND("&::signal&","S2",0) = -1) &::AMP& (STRING_FIND("&::signal&","ShaCal",0) = -1) &::AMP&  (STRING_FIND("&::signal&","V2G",0) = -1))
	! /AS_INTEGER=TRUE
	;
	
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_type
		/PARAMETER_VALUE=LINK_MODEL_BASED
		;
		
		Set_Pipeline_Parameter
		/PARAMETER_NAME=signal_folder
		/PARAMETER_VALUE=ORIGINAL
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=(((STRING_FIND("&::signal&","Moment",0) <> -1) | (STRING_FIND("&::signal&","Power",0) <> -1)) &::AMP& ("&::event_mode&" = "Instrumented treadmill (single belt)"))
		! /AS_INTEGER=TRUE
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=signal_folder
			/PARAMETER_VALUE=PROCESSED
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	!define event sequence - left
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(STRING_FIND("&::signal&","Left",0) <> -1)
	! /AS_INTEGER=TRUE
	;
	
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Angle",0) <> -1) | (STRING_FIND("&::signal&","Progression",0) <> -1) | (STRING_FIND("&::signal&","Arch",0) <> -1) | (STRING_FIND("&::signal&","F2",0) <> -1) | (STRING_FIND("&::signal&","MLA",0) <> -1) | (STRING_FIND("&::signal&","S2",0) <> -1) | (STRING_FIND("&::signal&","ShaCal",0) <> -1) | (STRING_FIND("&::signal&","V2G",0) <> -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=LHS+LHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=(STRING_FIND("&::signal&","GRF",0) <> -1)
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=LON+LOFF
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Moment",0) <> -1) | (STRING_FIND("&::signal&","Power",0) <> -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=LON+LHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Angle",0) = -1) &::AMP& (STRING_FIND("&::signal&","Progression",0) = -1) &::AMP& (STRING_FIND("&::signal&","Arch",0) = -1) &::AMP& (STRING_FIND("&::signal&","GRF",0) = -1) &::AMP& (STRING_FIND("&::signal&","Moment",0) = -1) &::AMP& (STRING_FIND("&::signal&","Power",0) = -1) &::AMP& (STRING_FIND("&::signal&","F2",0) = -1) &::AMP&  (STRING_FIND("&::signal&","MLA",0) = -1) &::AMP&  (STRING_FIND("&::signal&","S2",0) = -1) &::AMP& (STRING_FIND("&::signal&","ShaCal",0) = -1) &::AMP&  (STRING_FIND("&::signal&","V2G",0) = -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=LON+LHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	!define event sequence - right
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=(STRING_FIND("&::signal&","Right",0) <> -1)
	! /AS_INTEGER=TRUE
	;
	
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Angle",0) <> -1) | (STRING_FIND("&::signal&","Progression",0) <> -1) | (STRING_FIND("&::signal&","Arch",0) <> -1) | (STRING_FIND("&::signal&","F2",0) <> -1) | (STRING_FIND("&::signal&","MLA",0) <> -1) | (STRING_FIND("&::signal&","S2",0) <> -1) | (STRING_FIND("&::signal&","ShaCal",0) <> -1) | (STRING_FIND("&::signal&","V2G",0) <> -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=RHS+RHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=(STRING_FIND("&::signal&","GRF",0) <> -1)
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=RON+ROFF
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Moment",0) <> -1) | (STRING_FIND("&::signal&","Power",0) <> -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=RON+RHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=((STRING_FIND("&::signal&","Angle",0) = -1) &::AMP& (STRING_FIND("&::signal&","Progression",0) = -1) &::AMP& (STRING_FIND("&::signal&","Progression",0) = -1) &::AMP& (STRING_FIND("&::signal&","Arch",0) = -1) &::AMP& (STRING_FIND("&::signal&","GRF",0) = -1) &::AMP& (STRING_FIND("&::signal&","Moment",0) = -1) &::AMP& (STRING_FIND("&::signal&","Power",0) = -1) &::AMP& (STRING_FIND("&::signal&","F2",0) = -1) &::AMP&  (STRING_FIND("&::signal&","MLA",0) = -1) &::AMP&  (STRING_FIND("&::signal&","S2",0) = -1) &::AMP& (STRING_FIND("&::signal&","ShaCal",0) = -1) &::AMP&  (STRING_FIND("&::signal&","V2G",0) = -1))
		! /AS_INTEGER=TRUE
		;
		
			Set_Pipeline_Parameter
			/PARAMETER_NAME=ev_seg
			/PARAMETER_VALUE=RON+RHS
			;
			
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	For_Each
	/ITERATION_PARAMETER_NAME=component
	! /ITERATION_PARAMETER_COUNT_NAME=
	/ITEMS=X+Y+Z
	;

		Global_Normalized_Signal_Mean
		/SIGNAL_TYPES=::signal_type
		/SIGNAL_FOLDER=::signal_folder
		/SIGNAL_NAMES=::signal
		/SIGNAL_COMPONENTS=::component
		! /START_LABEL=
		! /END_LABEL=
		/EVENT_SEQUENCE=::ev_seg
		! /EXCLUDE_EVENTS=
		/RESULT_NAME=&::signal&_&::component
		/RESULT_FOLDER=TEMP
		! /NORMALIZE_POINTS=101
		/CREATE_STANDARD_DEVIATION=TRUE
		! /CALCULATE_PER_FILE=FALSE
		;
		
	End_For_Each
	/ITERATION_PARAMETER_NAME=component
	;

End_For_Each
/ITERATION_PARAMETER_NAME=signal
;

!Combine the three signal components into one signal
Select_Active_File 
/FILE_NAME=GLOBAL 
;

For_Each
/ITERATION_PARAMETER_NAME=signal
/ITEMS=::link_signal_names
;

	Evaluate_Expression
	/EXPRESSION=vector(P2D::TEMP::&::signal&_X::Y, P2D::TEMP::&::signal&_Y::Y, P2D::TEMP::&::signal&_Z::Y)
	/RESULT_NAME=&::signal&_MEAN
	/RESULT_TYPE=P2D
	/RESULT_FOLDER=TIMESERIES
	;

End_For_Each
/ITERATION_PARAMETER_NAME=signal
;

!delete temporary folder
Delete_Folder
/SIGNAL_TYPE=P2D
/FOLDER=TEMP
;

!====================================
!Export events
!====================================
Select_Active_File 
/FILE_NAME=Dynamic
;

!make copy of LHS an RHS events to make them available for web report
Evaluate_Expression
/EXPRESSION=EVENT_LABEL::ORIGINAL::LHS
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=EVENTS_TIMES
/RESULT_NAME=LHS
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Evaluate_Expression
/EXPRESSION=EVENT_LABEL::ORIGINAL::RHS
! /SIGNAL_TYPES=
! /SIGNAL_FOLDER=ORIGINAL
! /SIGNAL_NAMES=
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=EVENTS_TIMES
/RESULT_NAME=RHS
! /APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=EVENTS_NORMALISED+EVENTS_TIMES
/FILE_NAME=&::working_directory&events.xml
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
! /SIGNAL_PRECISION=
! /START_LABEL=
! /END_LABEL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
/USE_XML_FORMAT=TRUE
/USE_SHORT_FILENAME=TRUE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_NAN=FALSE
;

Select_Active_File 
/FILE_NAME=GLOBAL 
;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=EVENTS_NORMALISED
/FILE_NAME=&::working_directory&events_global.xml
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
! /SIGNAL_PRECISION=
! /START_LABEL=
! /END_LABEL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
/USE_XML_FORMAT=TRUE
/USE_SHORT_FILENAME=TRUE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_NAN=FALSE
;

!====================================
!Export Metrics to xml file
!====================================
Select_Active_File
/FILE_NAME=Dynamic
! /QUERY=
;

Export_Data_To_Ascii_File
/SIGNAL_TYPES=METRIC+METRIC+METRIC
/SIGNAL_FOLDER=TMPD+MAP+SUBJECT
! /SIGNAL_NAMES=
/FILE_NAME=&::working_directory&metrics_per_trial.xml
! /SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
! /SIGNAL_PRECISION=
! /START_LABEL=
! /END_LABEL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
/USE_XML_FORMAT=TRUE
/USE_SHORT_FILENAME=TRUE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
! /EXPORT_NAN=FALSE
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

Export_Data_To_Ascii_File
/FILE_NAME=&::working_directory&metrics.xml
/SIGNAL_TYPES=METRIC
/SIGNAL_NAMES=	AGE+Height+Weight+

				CadenceCount+CadenceMean+CadenceSD+LDblSuppCount+LDblSuppMean+LDblSuppPctMean+LDblSuppPctSD+LDblSuppSD+LStanPctMean+LStanPctSD+
				LStanPctCount+LStanTimeMean+LStanTimeSD+LStepLenCount+LStepLenMean+LStepLenSD+LStepPerMinCount+LStepPerMinMean+LStepPerMinSD+LStepTimeCount+
				LStepTimeMean+LStepTimeSD+LSwingPctMean+LSwingPctSD+LSwingTimeMean+LSwingTimeSD+RDblSuppCount+RDblSuppMean+RDblSuppPctMean+RDblSuppPctSD+
				RDblSuppSD+RStanPctMean+RStanPctSD+RStanPctCount+RStanTimeMean+RStanTimeSD+RStepLenCount+RStepLenMean+RStepLenSD+RStepPerMinCount+
				RStepPerMinMean+RStepPerMinSD+RStepTimeCount+RStepTimeMean+RStepTimeSD+RSwingPctMean+RSwingPctSD+RSwingTimeMean+RSwingTimeSD+Speed_m_per_minMean+
				StrideLenCount+StrideLenMean+StrideLenSD+StrideMinCount+StrideMinMean+StrideMinSD+StrideWidCount+StrideWidMean+StrideWidSD+StriTimeMean+

				Cycle_Time_Count+Cycle_Time_Mean+Cycle_Time_StdDev+Double_Limb_Support_Time_Ave+Double_Limb_Support_Time_Count+Double_Limb_Support_Time_StdDev+Left_Cycle_Time_Count+Left_Cycle_Time_Mean+Left_Cycle_Time_StdDev+Left_Stance_Time_Count+
				Left_Stance_Time_Mean+Left_Stance_Time_StdDev+Left_Steps_Per_Minute_Count+Left_Steps_Per_Minute_Mean+Left_Steps_Per_Minute_StdDev+Left_Step_Length_Count+Left_Step_Length_Mean+Left_Step_Length_StdDev+Left_Step_Time_Count+Left_Step_Time_Mean+
				Left_Step_Time_StdDev+Left_Strides_Per_Minute_Count+Left_Strides_Per_Minute_Mean+Left_Strides_Per_Minute_StdDev+Left_Stride_Length_Count+Left_Stride_Length_Mean+Left_Stride_Length_StdDev+Left_Swing_Time_Count+Left_Swing_Time_Mean+Left_Swing_Time_StdDev+
				NUM_FILES+Right_Cycle_Time_Count+Right_Cycle_Time_Mean+Right_Cycle_Time_StdDev+Right_Initial_Double_Limb_Support_Time_Count+Right_Initial_Double_Limb_Support_Time_Mean+Right_Initial_Double_Limb_Support_Time_StdDev+Right_Stance_Time_Count+Right_Stance_Time_Mean+Right_Stance_Time_StdDev+
				Right_Steps_Per_Minute_Count+Right_Steps_Per_Minute_Mean+Right_Steps_Per_Minute_StdDev+Right_Step_Length_Count+Right_Step_Length_Mean+Right_Step_Length_StdDev+Right_Step_Time_Count+Right_Step_Time_Mean+Right_Step_Time_StdDev+Right_Strides_Per_Minute_Count+
				Right_Strides_Per_Minute_Mean+Right_Strides_Per_Minute_StdDev+Right_Stride_Length_Count+Right_Stride_Length_Mean+Right_Stride_Length_StdDev+Right_Swing_Time_Count+Right_Swing_Time_Mean+Right_Swing_Time_StdDev+Right_Terminal_Double_Limb_Support_Time_Count+Right_Terminal_Double_Limb_Support_Time_Mean+
				Right_Terminal_Double_Limb_Support_Time_StdDev+Speed+Speed_STDDEV+Statures_Per_Second+Stride_Length_Count+Stride_Length_Mean+Stride_Length_StdDev+Stride_Width_Count+Stride_Width_Mean+Stride_Width_StdDev+Left_GPS_IQR+
				SpeedNormPctDiff+CadenceNormPctDiff+Stride_LengthNormPctDiff+Left_Step_LengthNormPctDiff+Right_Step_LengthNormPctDiff+
				
				Left_GPS_ln_mean_MEAN+Left_GPS_ln_mean_STDDEV+Left_GPS_mean_MEAN+Left_GPS_mean_STDDEV+Left_GPS_MEDIAN+Overall_GPS_IQR+Overall_GPS_ln_mean_MEAN+Overall_GPS_ln_mean_STDDEV+Overall_GPS_mean_MEAN+Overall_GPS_mean_STDDEV+
				Overall_GPS_MEDIAN+Right_GPS_IQR+Right_GPS_ln_mean_MEAN+Right_GPS_ln_mean_STDDEV+Right_GPS_mean_MEAN+Right_GPS_mean_STDDEV+Right_GPS_MEDIAN+Left Ankle Angles_X_gvs_ln_mean_MEAN+Left Ankle Angles_X_gvs_ln_mean_STDDEV+Left Ankle Angles_X_gvs_MEDIAN+
				Left Ankle Angles_X_IQR+Left Foot Progression_Z_gvs_ln_mean_MEAN+Left Foot Progression_Z_gvs_ln_mean_STDDEV+Left Foot Progression_Z_gvs_MEDIAN+Left Foot Progression_Z_IQR+Left Foot Prog_Z_gvs_MEDIAN+Left Hip Angles_X_gvs_ln_mean_MEAN+Left Hip Angles_X_gvs_ln_mean_STDDEV+Left Hip Angles_X_gvs_MEDIAN+Left Hip Angles_X_IQR+
				Left Hip Angles_Y_gvs_ln_mean_MEAN+Left Hip Angles_Y_gvs_ln_mean_STDDEV+Left Hip Angles_Y_gvs_MEDIAN+Left Hip Angles_Y_IQR+Left Hip Angles_Z_gvs_ln_mean_MEAN+Left Hip Angles_Z_gvs_ln_mean_STDDEV+Left Hip Angles_Z_gvs_MEDIAN+Left Hip Angles_Z_IQR+Left Knee Angles_X_gvs_ln_mean_MEAN+Left Knee Angles_X_gvs_ln_mean_STDDEV+
				Left Knee Angles_X_gvs_MEDIAN+Left Knee Angles_X_IQR+Left Pelvic Angles_X_gvs_ln_mean_MEAN+Left Pelvic Angles_X_gvs_ln_mean_STDDEV+Left Pelvic Angles_X_gvs_MEDIAN+Left Pelvic Angles_X_IQR+Left Pelvic Angles_Y_gvs_ln_mean_MEAN+Left Pelvic Angles_Y_gvs_ln_mean_STDDEV+Left Pelvic Angles_Y_gvs_MEDIAN+Left Pelvic Angles_Y_IQR+
				Left Pelvic Angles_Z_gvs_ln_mean_MEAN+Left Pelvic Angles_Z_gvs_ln_mean_STDDEV+Left Pelvic Angles_Z_gvs_MEDIAN+Left Pelvic Angles_Z_IQR+Right Ankle Angles_X_gvs_ln_mean_MEAN+Right Ankle Angles_X_gvs_ln_mean_STDDEV+Right Ankle Angles_X_gvs_MEDIAN+Right Ankle Angles_X_IQR+Right Foot Progression_Z_gvs_ln_mean_MEAN+Right Foot Progression_Z_gvs_ln_mean_STDDEV+
				Right Foot Progression_Z_gvs_MEDIAN+Right Foot Progression_Z_IQR+Right Foot Prog_Z_gvs_MEDIAN+Right Hip Angles_X_gvs_ln_mean_MEAN+Right Hip Angles_X_gvs_ln_mean_STDDEV+Right Hip Angles_X_gvs_MEDIAN+Right Hip Angles_X_IQR+Right Hip Angles_Y_gvs_ln_mean_MEAN+Right Hip Angles_Y_gvs_ln_mean_STDDEV+Right Hip Angles_Y_gvs_MEDIAN+
				Right Hip Angles_Y_IQR+Right Hip Angles_Z_gvs_ln_mean_MEAN+Right Hip Angles_Z_gvs_ln_mean_STDDEV+Right Hip Angles_Z_gvs_MEDIAN+Right Hip Angles_Z_IQR+Right Knee Angles_X_gvs_ln_mean_MEAN+Right Knee Angles_X_gvs_ln_mean_STDDEV+Right Knee Angles_X_gvs_MEDIAN+Right Knee Angles_X_IQR+Right Pelvic Angles_X_gvs_ln_mean_MEAN+
				Right Pelvic Angles_X_gvs_ln_mean_STDDEV+Right Pelvic Angles_X_gvs_MEDIAN+Right Pelvic Angles_X_IQR+Right Pelvic Angles_Y_gvs_ln_mean_MEAN+Right Pelvic Angles_Y_gvs_ln_mean_STDDEV+Right Pelvic Angles_Y_gvs_MEDIAN+Right Pelvic Angles_Y_IQR+Right Pelvic Angles_Z_gvs_ln_mean_MEAN+Right Pelvic Angles_Z_gvs_ln_mean_STDDEV+Right Pelvic Angles_Z_gvs_MEDIAN+
				Right Pelvic Angles_Z_IQR+Left Plv Ang_X_gvs_MEDIAN+Left Plv Ang_Y_gvs_MEDIAN+Left Plv Ang_Z_gvs_MEDIAN+Right Ank Ang_X_gvs_MEDIAN+

/SIGNAL_FOLDER=	SUBJECT+SUBJECT+SUBJECT+

				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+
				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+
				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+
				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+
				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+
				SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+SHORT+

				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+
				TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+TMPD+MAP+
				TMPD+TMPD+TMPD+TMPD+TMPD+
				
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+MAP+
				MAP+MAP+MAP+MAP+MAP+

! /SIGNAL_COMPONENTS=
!/COMPONENT_SEQUENCE=ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, ALL, 
/SIGNAL_PRECISION=	1+2+1+

					0+0+2+0+2+2+2+2+2+2+
					0+2+2+0+2+2+0+2+2+0+
					2+2+2+2+2+2+0+2+2+2+
					2+2+2+0+2+2+0+2+2+0+
					2+2+0+2+2+2+2+2+2+2+
					0+2+2+0+2+2+0+2+2+2+
					
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+
					2+2+2+2+2+2+2+2+2+2+2+
					0+0+0+0+0+
					
					1+1+1+2+1+2+1+2+1+2+
					1+2+1+2+1+2+1+1+2+1+
					1+1+2+1+2+1+1+2+1+2+
					1+2+1+2+1+2+1+2+1+2+
					1+2+1+2+1+2+1+2+1+2+
					1+2+1+2+1+2+1+2+1+2+
					1+2+1+1+2+1+2+1+2+1+
					2+1+2+1+2+1+2+1+2+1+
					2+1+2+1+2+1+2+1+2+1+
					2+1+1+1+1
! /START_LABEL=
! /END_LABEL=
!/EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
! /USE_XML_FORMAT=FALSE
/USE_XML_FORMAT=TRUE
! /USE_SHORT_FILENAME=FALSE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
;

!export min and max values to xml and use them to set Word report y axis
Export_Data_To_Ascii_File
/FILE_NAME=&::working_directory&min_max.xml
/SIGNAL_TYPES=METRIC
/SIGNAL_NAMES=
/SIGNAL_FOLDER=MIN_MAX
! /SIGNAL_COMPONENTS=
/COMPONENT_SEQUENCE=ALL
! /SIGNAL_PRECISION=
! /START_LABEL=
! /END_LABEL=
! /EVENT_SEQUENCE=
! /EXCLUDE_EVENTS=
! /USE_POINT_RATE=FALSE
! /NORMALIZE_DATA=FALSE
! /NORMALIZE_POINTS=101
! /EXPORT_MEAN_AND_STD_DEV=FALSE
! /USE_P2D_FORMAT=FALSE
/USE_XML_FORMAT=TRUE
! /USE_SHORT_FILENAME=FALSE
! /EXPORT_EMPTY_SIGNALS=FALSE
! /EXPORT_WITHOUT_HEADER=FALSE
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::noraxon_exists&" = "TRUE") | ("&::delsys_trigno_exists&" = "TRUE") | ("&::mega_me6000_exists&" = "TRUE") | ("&::myon_exists&" = "TRUE") | ("&::analog_EMG_exists&" = "TRUE"))
! /AS_INTEGER=TRUE
;
	
	! Export EMG maxima to xml file (to be used to set maximum of y-axis scale for Word report)
	Export_Data_To_Ascii_File
	/FILE_NAME=&::working_directory&metrics_EMG.xml
	/SIGNAL_TYPES=METRIC
	! /SIGNAL_NAMES=
	/SIGNAL_FOLDER=EMG
	! /SIGNAL_COMPONENTS=
	/COMPONENT_SEQUENCE=ALL
	! /SIGNAL_PRECISION=
	! /START_LABEL=
	! /END_LABEL=
	/EVENT_SEQUENCE=BOF+EOF
	! /EXCLUDE_EVENTS=
	! /USE_POINT_RATE=FALSE
	! /NORMALIZE_DATA=FALSE
	! /NORMALIZE_POINTS=101
	! /EXPORT_MEAN_AND_STD_DEV=FALSE
	! /USE_P2D_FORMAT=FALSE
	/USE_XML_FORMAT=TRUE
	! /USE_SHORT_FILENAME=FALSE
	! /EXPORT_EMPTY_SIGNALS=FALSE
	! /EXPORT_WITHOUT_HEADER=FALSE
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

!====================================
! Export timeseries to xml file
!====================================

! =============================================	
! Calculate per-cycle within-trial mean values for Word and instrumented treadmill
! =============================================	

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::analysis_name&" = "Internal Export Word") &::AMP& ((STRING_FIND("&::event_mode&","Instrumented treadmill",0) <> -1) | ("&::auto_range_str&" = "FALSE")))
! /AS_INTEGER=TRUE
;

	! make a backup of LINK_MODEL_BASED::ORIGINAL folder. Backup will be used to restore data for V3D report after export to Word
	Select_Active_File
	/FILE_NAME=ALL_FILES
	! /QUERY=
	;
	
	Copy_Folder
	/SIGNAL_TYPE=LINK_MODEL_BASED
	/EXISTING_FOLDER=ORIGINAL
	/NEW_FOLDER_NAME=BACKUP
	/OVERWRITE_EXISTING_SIGNALS=TRUE
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond1
	/EXPRESSION=(("&::noraxon_exists&" = "TRUE") | ("&::normative_non_noraxon_file_exists&" = "TRUE"))
	! /AS_INTEGER=TRUE
	;

		Copy_Folder
		/SIGNAL_TYPE=ANALOG
		/EXISTING_FOLDER=EMG_PROCESSED
		/NEW_FOLDER_NAME=EMG_PROCESSED_BACKUP
		/OVERWRITE_EXISTING_SIGNALS=TRUE
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond1
	;

	Set_Pipeline_Parameter_To_List_Of_Tagged_Files
	/PARAMETER_NAME=files
	! /TAG_NAME=
	/GET_CURRENT_SELECTED_FILES=TRUE
	/USE_SHORT_FILENAMES=FALSE
	;

	For_Each
	/ITERATION_PARAMETER_NAME=file
	/ITERATION_PARAMETER_COUNT_NAME=inc
	/ITEMS=::files
	;

		Select_Active_File
		/FILE_NAME=::file 
		! /QUERY=
		;

		Event_Explicit
		/EVENT_NAME=start
		/FRAME=1
		! /TIME=
		;

		Event_Explicit
		/EVENT_NAME=end
		/FRAME=eof
		! /TIME=
		;

		Evaluate_Expression
		/EXPRESSION=PARAMETERS::POINT::FRAMES 
		/RESULT_NAME=LAST_FRAME
		! /RESULT_TYPE=DERIVED
		! /RESULT_FOLDER=PROCESSED
		;

		Set_Pipeline_Parameter_To_Data_Value
		/PARAMETER_NAME=LAST_FRAME
		/SIGNAL_TYPES=DERIVED
		/SIGNAL_NAMES=LAST_FRAME
		/SIGNAL_FOLDER=PROCESSED
		! /SIGNAL_COMPONENTS=ALL_COMPONENTS
		;

		!create sepatare p2d signal for each component 
		For_Each
		/ITERATION_PARAMETER_NAME=AXIS
		/ITEMS=X+Y+Z
		;
			Global_Normalized_Signal_Mean
			/SIGNAL_TYPES=DERIVED
			/SIGNAL_NAMES=LEFT GRF
			/SIGNAL_FOLDER=FORCE_GRAPH
			/SIGNAL_COMPONENTS=::AXIS
			! /START_LABEL=
			! /END_LABEL=
			/EVENT_SEQUENCE=LON+LOFF
			! /EXCLUDE_EVENTS=
			/RESULT_NAME=LEFT GRF_&::AXIS
			/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc&
			/NORMALIZE_POINTS=::LAST_FRAME
			! /CREATE_STANDARD_DEVIATION=FALSE
			! /CALCULATE_PER_FILE=FALSE
			;

			Global_Normalized_Signal_Mean
			/SIGNAL_TYPES=DERIVED
			/SIGNAL_NAMES=RIGHT GRF
			/SIGNAL_FOLDER=FORCE_GRAPH
			/SIGNAL_COMPONENTS=::AXIS
			! /START_LABEL=
			! /END_LABEL=
			/EVENT_SEQUENCE=RON+ROFF
			! /EXCLUDE_EVENTS=
			/RESULT_NAME=RIGHT GRF_&::AXIS
			/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc&
			/NORMALIZE_POINTS=::LAST_FRAME
			! /CREATE_STANDARD_DEVIATION=FALSE
			! /CALCULATE_PER_FILE=FALSE
			;

		End_For_Each
		/ITERATION_PARAMETER_NAME=AXIS
		;

		Evaluate_Expression
		/EXPRESSION=vector(GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&LEFT GRF_X::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&LEFT GRF_Y::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&LEFT GRF_Z::Y)
		/RESULT_NAME=LEFT GRF
		/RESULT_TYPE=LINK_MODEL_BASED
		/RESULT_FOLDER=PROCESSED
		;

		Evaluate_Expression
		/EXPRESSION=vector(GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&RIGHT GRF_X::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&RIGHT GRF_Y::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&RIGHT GRF_Z::Y)
		/RESULT_NAME=RIGHT GRF
		/RESULT_TYPE=LINK_MODEL_BASED
		/RESULT_FOLDER=PROCESSED
		;

		Set_Pipeline_Parameter
		/PARAMETER_NAME=SIGNALS_LEFT
		/PARAMETER_VALUE=Left Foot Progression+Left Ankle Angles+Left Foot Pitch Angles+Left Hip Angles+Left Knee Angles+Left Pelvic Angles
		;
		
		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=("&::includes_thorax&" = "TRUE")
		! /AS_INTEGER=TRUE
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=SIGNALS_LEFT
			/PARAMETER_VALUE=&::SIGNALS_LEFT&+Left Thorax Angles+Left Thorax_Lab Angles
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=("&::includes_arms&" = "TRUE")
		! /AS_INTEGER=TRUE
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=SIGNALS_LEFT
			/PARAMETER_VALUE=&::SIGNALS_LEFT&+Left Shoulder Angles+Left Elbow Angles
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=("&::includes_OFM&" = "TRUE")
		! /AS_INTEGER=TRUE
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=SIGNALS_LEFT
			/PARAMETER_VALUE=&::SIGNALS_LEFT&+Left Forefoot Hindfoot Angle+Left Forefoot Tibia Angle+Left Hallux Forefoot Angle+Left Hindfoot Tibia Angle+Left Arch Height
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		Conditional_Statement
		/ITERATION_PARAMETER_NAME=cond1
		/EXPRESSION=("&::includes_RFM&" = "TRUE")
		! /AS_INTEGER=TRUE
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=SIGNALS_LEFT
			/PARAMETER_VALUE=&::SIGNALS_LEFT&+Left Forefoot Hindfoot Angle+Left Forefoot Midfoot Angle+Left Hallux Forefoot Angle+Left Hindfoot Midfoot Angle+Left Hindfoot Tibia Angle+Left Shank IORFoot Angle+Left F2G+Left F2Ps+Left F2Pt+Left MLA+Left S2F+Left S2G+Left S2V+Left ShaCal_Static+Left V2G
			;
		
		Conditional_Statement_End
		/ITERATION_PARAMETER_NAME=cond1
		;

		For_Each
		/ITERATION_PARAMETER_NAME=SIGNAL_LIST_LEFT
		/ITEMS=::SIGNALS_LEFT
		;

			Set_Pipeline_Parameter
			/PARAMETER_NAME=signal_type
			/PARAMETER_VALUE=LINK_MODEL_BASED
			;
			
			Set_Pipeline_Parameter
			/PARAMETER_NAME=signal_folder
			/PARAMETER_VALUE=ORIGINAL
			;
			
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond2
			/EXPRESSION=((STRING_FIND("&::SIGNAL_LIST_LEFT&","F2",0) <> -1) | (STRING_FIND("&::SIGNAL_LIST_LEFT&","MLA",0) <> -1) | (STRING_FIND("&::SIGNAL_LIST_LEFT&","S2",0) <> -1) | (STRING_FIND("&::SIGNAL_LIST_LEFT&","ShaCal",0) <> -1) | (STRING_FIND("&::SIGNAL_LIST_LEFT&","V2G",0) <> -1))
			! /AS_INTEGER=TRUE
			;
			
				Set_Pipeline_Parameter
				/PARAMETER_NAME=signal_type
				/PARAMETER_VALUE=DERIVED
				;
				
				Set_Pipeline_Parameter
				/PARAMETER_NAME=signal_folder
				/PARAMETER_VALUE=RIZZOLI
				;
				
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond2
			;

			Global_Normalized_Signal_Mean
			/SIGNAL_TYPES=::signal_type
			/SIGNAL_NAMES=::SIGNAL_LIST_LEFT
			/SIGNAL_FOLDER=::signal_folder
			/SIGNAL_COMPONENTS=X
			! /START_LABEL=
			! /END_LABEL=
			/EVENT_SEQUENCE=LHS+LHS
			! /EXCLUDE_EVENTS=
			/RESULT_NAME=::SIGNAL_LIST_LEFT&_X
			/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc&
			/NORMALIZE_POINTS=::LAST_FRAME
			! /CREATE_STANDARD_DEVIATION=FALSE
			! /CALCULATE_PER_FILE=FALSE
			;

			Global_Normalized_Signal_Mean
			/SIGNAL_TYPES=::signal_type
			/SIGNAL_NAMES=::SIGNAL_LIST_LEFT
			/SIGNAL_FOLDER=::signal_folder
			/SIGNAL_COMPONENTS=Y
			! /START_LABEL=
			! /END_LABEL=
			/EVENT_SEQUENCE=LHS+LHS
			! /EXCLUDE_EVENTS=
			/RESULT_NAME=::SIGNAL_LIST_LEFT&_Y
			/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc&
			/NORMALIZE_POINTS=::LAST_FRAME
			! /CREATE_STANDARD_DEVIATION=FALSE
			! /CALCULATE_PER_FILE=FALSE
			;

			Global_Normalized_Signal_Mean
			/SIGNAL_TYPES=::signal_type
			/SIGNAL_NAMES=::SIGNAL_LIST_LEFT
			/SIGNAL_FOLDER=::signal_folder
			/SIGNAL_COMPONENTS=Z
			! /START_LABEL=
			! /END_LABEL=
			/EVENT_SEQUENCE=LHS+LHS
			! /EXCLUDE_EVENTS=
			/RESULT_NAME=::SIGNAL_LIST_LEFT&_Z
			/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc& 
			/NORMALIZE_POINTS=::LAST_FRAME
			! /CREATE_STANDARD_DEVIATION=FALSE
			! /CALCULATE_PER_FILE=FALSE
			;
			
			! combine 3 p2d signals into one signal and overwrite link_model_based signals with means
			! to make them available for export (without renaming signals)
			Evaluate_Expression
			/EXPRESSION=vector(GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_LEFT&_X::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_LEFT&_Y::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_LEFT&_Z::Y)
			/RESULT_NAME=::SIGNAL_LIST_LEFT
			/RESULT_TYPE=LINK_MODEL_BASED
			/RESULT_FOLDER=PROCESSED
			;

		End_For_Each
		/ITERATION_PARAMETER_NAME=SIGNAL_LIST_LEFT
		;

		For_Each
		/ITERATION_PARAMETER_NAME=SIGNAL_LIST_LEFT
		/ITEMS=Left Ankle Moment+Left Ankle Power+Left Hip Moment+Left Hip Power+Left Knee Moment+Left Knee Power
		;
		
			Conditional_Statement
			/ITERATION_PARAMETER_NAME=cond1
			/EXPRESSION=("&::event_mode&" = "Instrumented treadmill (single belt)")
			! /AS_INTEGER=TRUE
			;

				Set_Data_To_New_Values
				/SIGNAL_TYPES=LINK_MODEL_BASED
				! /SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_NAMES=::SIGNAL_LIST_LEFT
				! /SIGNAL_COMPONENTS=ALL_COMPONENTS
				! /RESULT_TYPES=
				! /RESULT_FOLDERS=PROCESSED
				! /RESULT_SUFFIX=
				/EVENT_SEQUENCE=LHS+RTO
				! /EXCLUDE_EVENTS=
				! /START_FRAME=
				! /END_FRAME=
				! /USE_POINT_RATE=TRUE
				! /REPLACEMENT_VALUES=NO_DATA
				! /THRESHOLD_HIGH=NO_DATA
				! /THRESHOLD_LOW=NO_DATA
				! /SET_DATA_AT_SINGLE_EVENT=FALSE
				;

				Set_Data_To_New_Values
				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_FOLDER=PROCESSED
				/SIGNAL_NAMES=::SIGNAL_LIST_LEFT
				! /SIGNAL_COMPONENTS=ALL_COMPONENTS
