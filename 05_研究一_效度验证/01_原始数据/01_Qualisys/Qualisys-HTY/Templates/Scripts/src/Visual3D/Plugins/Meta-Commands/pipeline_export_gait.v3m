/METRIC_VALUE=METRIC::TMPD::Left_Step_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepPerMinCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Steps_Per_Minute_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepPerMinCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Steps_Per_Minute_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepPerMinMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Steps_Per_Minute_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepPerMinMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Steps_Per_Minute_Mean
;

