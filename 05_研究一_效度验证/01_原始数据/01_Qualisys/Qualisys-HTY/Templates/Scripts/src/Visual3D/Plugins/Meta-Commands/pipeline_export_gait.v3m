/METRIC_VALUE=METRIC::TMPD::Right_Step_Length_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepLenMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Step_Length_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepLenSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Step_Length_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepLenSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Step_Length_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepTimeCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Step_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepTimeCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Step_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepTimeMean
