		For_Each
		/ITERATION_PARAMETER_NAME=SIGNAL_LIST_RIGHT
		/ITEMS=RIGHT Ankle Moment+RIGHT Ankle Power+RIGHT Hip Moment+RIGHT Hip Power+RIGHT Knee Moment+RIGHT Knee Power
		;
		
			Conditional_Statement
