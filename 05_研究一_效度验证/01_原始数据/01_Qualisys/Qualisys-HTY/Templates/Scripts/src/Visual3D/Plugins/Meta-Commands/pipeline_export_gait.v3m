			/ITEMS=&::EMG_graph_signals_name_right
			;
			
				Global_Normalized_Signal_Mean
				/SIGNAL_TYPES=ANALOG
				/SIGNAL_NAMES=::emg
				/SIGNAL_FOLDER=EMG_PROCESSED
				! /SIGNAL_COMPONENTS=
				! /COMPONENT_SEQUENCE=
				! /START_LABEL=
				! /END_LABEL=
				/EVENT_SEQUENCE=RHS+RHS
				! /EXCLUDE_EVENTS=
				/RESULT_NAME=::emg
				/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc& 
