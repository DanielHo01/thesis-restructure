				/SIGNAL_TYPES=LINK_MODEL_BASED
				/SIGNAL_NAMES=::SIGNAL_LIST_RIGHT
				/SIGNAL_FOLDER=ORIGINAL
				/SIGNAL_COMPONENTS=Z
				! /START_LABEL=
				! /END_LABEL=
				/EVENT_SEQUENCE=RON+RHS
				! /EXCLUDE_EVENTS=
				/RESULT_NAME=::SIGNAL_LIST_RIGHT&_Z
				/RESULT_FOLDER=WITHIN_TRIAL_NO_&::inc& 
				/NORMALIZE_POINTS=::LAST_FRAME
				! /CREATE_STANDARD_DEVIATION=FALSE
				! /CALCULATE_PER_FILE=FALSE
				;
			
			Conditional_Statement_End
			/ITERATION_PARAMETER_NAME=cond1
			;

			! combine 3 p2d signals into one signal and overwrite link_model_based signals with means
			! to make them available for export (without renaming signals)
			Evaluate_Expression
			/EXPRESSION=vector(GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_RIGHT&_X::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_RIGHT&_Y::Y, GLOBAL::P2D::WITHIN_TRIAL_NO_&::inc&:&:&::SIGNAL_LIST_RIGHT&_Z::Y)
			/RESULT_NAME=::SIGNAL_LIST_RIGHT
			/RESULT_TYPE=LINK_MODEL_BASED
			/RESULT_FOLDER=PROCESSED
