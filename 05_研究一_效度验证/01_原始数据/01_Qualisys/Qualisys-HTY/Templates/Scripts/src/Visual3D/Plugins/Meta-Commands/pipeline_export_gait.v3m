;

Metric_Explicit
/RESULT_METRIC_NAME=LStepPerMinSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Steps_Per_Minute_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=RStanTimeCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Stance_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=LStanTimeCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Stance_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=RStanTimeMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Stance_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=LStanTimeMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Stance_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=RStanTimeSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Stance_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=LStanTimeSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Stance_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=RSwingTimeMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Swing_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=LSwingTimeMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Swing_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=RSwingTimeSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Swing_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=LSwingTimeSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Swing_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=RDblSuppCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Initial_Double_Limb_Support_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=RDblSuppMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Initial_Double_Limb_Support_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=RDblSuppSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Initial_Double_Limb_Support_Time_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=LDblSuppCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_Count
;

