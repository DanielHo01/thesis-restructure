! BEGIN_META
! META_CMD_NAME	= Pipeline_Export_Gait
! META_PARAM	= working_directory  :   string ::yes
! META_PARAM	= openfile  :   string ::yes
! META_PARAM	= analysis_name  :   string ::yes
! META_PARAM	= event_mode  :   string ::yes
! META_PARAM	= auto_range_str  :   string ::yes
! META_PARAM	= normative_data  :   string ::yes
! META_PARAM	= normative_file_exists  :   string ::yes
! META_PARAM	= normative_directory  :   string ::yes
! META_PARAM	= normative_file  :   string ::yes
! META_PARAM	= select_tags_list  :   string ::yes
! META_PARAM	= select_tags_arr_list  :   string ::yes
! META_PARAM	= link_signal_names  :   string ::yes
! META_PARAM	= event_seq  :   string ::yes
! META_PARAM	= includes_OFM  :   string ::yes
! META_PARAM	= includes_RFM  :   string ::yes
! META_PARAM	= noraxon_exists  :   string ::yes
! META_PARAM	= mega_me6000_exists  :   string ::yes
! META_PARAM	= delsys_trigno_exists  :   string ::yes
! META_PARAM	= myon_exists  :   string ::yes
! META_PARAM	= analog_EMG_exists  :   string ::yes
! META_PARAM	= EMG_signal_names  :   string ::yes
! META_PARAM	= EMG_type  :   string ::yes
! META_PARAM	= EMG_folder  :   string ::yes
! META_PARAM	= EMG_exclude_seq  :   string ::yes
! META_PARAM	= EMG_event_seq  :   string ::yes
! META_PARAM	= EMG_points  :   string ::yes
! META_PARAM	= EMG_names_norm  :   string ::yes
! META_PARAM	= EMG_type_norm  :   string ::yes
! META_PARAM	= EMG_folder_norm  :   string ::yes
! META_PARAM	= EMG_points_norm  :   string ::yes
! META_PARAM	= normative_non_noraxon_file_exists  :   string ::yes
! META_PARAM	= EMG_graph_signals_name_left  :   string ::yes
! META_PARAM	= EMG_graph_signals_name_right  :   string ::yes
! META_PARAM	= includes_thorax  :   string ::yes
! META_PARAM	= includes_arms  :   string ::yes
! META_PARAM	= event_sq  :   string ::yes
! META_PARAM	= sig_types  :   string ::yes
! META_PARAM	= sig_names  :   string ::yes
! META_PARAM	= sig_folder  :   string ::yes
! META_PARAM	= sig_types_web  :   string ::yes
! META_PARAM	= sig_names_web  :   string ::yes
! META_PARAM	= sig_folder_web  :   string ::yes
! META_PARAM	= ev_segence  :   string ::yes
! META_PARAM	= ev_exclude  :   string ::yes
! META_PARAM	= norm_points  :   string ::yes
! META_PARAM	= EMG_units_pct_str  :   string ::yes
! META_PARAM	= sig_type_n  :   string ::yes
! META_PARAM	= sig_names_n  :   string ::yes
! META_PARAM	= sig_folder_n  :   string ::yes
! META_PARAM	= norm_points_n  :   string ::yes
! META_PARAM	= sig_type_3dv  :   string ::yes
! META_PARAM	= sig_folder_3dv  :   string ::yes
! META_PARAM	= marker_list_3dv  :   string ::yes
! META_PARAM	= norm_points_3dv  :   string ::yes
! META_PARAM	= cmo_file  :   string ::yes
! END_META

! +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
!  Copyright notice
!  This PAF and its content is copyright of Qualisys AB © 2012-2018. All rights reserved. 
!  The PAF script is only to be used in conjunction with a Qualisys Motion Capture System. 
!  Only legal PAF owners are entitled to use the script and only in relation with related PAF.
! +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

Set_View_Processing_Results
! /ACCUMULATE_PIPELINE_RESULTS=ALL
! /ACCUMULATE_BUILDMODEL_RESULTS=ALL
! /RESET_PIPELINE_RESULTS=FALSE
! /RESET_BUILDMODEL_RESULTS=FALSE
! /VIEW_PIPELINE_RESULTS=1
! /VIEW_BUILDMODEL_RESULTS=2
! /VIEW_RECALC_PIPELINE_WARNINGS=2
;

File_Open
/FILE_NAME=::openfile
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::analysis_name&" = "Internal Export Word") &::AMP& ("&::auto_range_str&" = "TRUE") &::AMP& ("&::event_mode&" = "Multiple forceplates"))
! /AS_INTEGER=TRUE
;

	Event_Delete
	/EVENT_NAME=LHS
	/EVENT_SEQUENCE=START+RANGESTART
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=RHS
	/EVENT_SEQUENCE=START+RANGESTART
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=LTO
	/EVENT_SEQUENCE=START+RANGESTART
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=RTO
	/EVENT_SEQUENCE=START+RANGESTART
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=LHS
	/EVENT_SEQUENCE=RANGEEND+END
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=RHS
	/EVENT_SEQUENCE=RANGEEND+END
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=LTO
	/EVENT_SEQUENCE=RANGEEND+END
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

	Event_Delete
	/EVENT_NAME=RTO
	/EVENT_SEQUENCE=RANGEEND+END
	! /EXCLUDE_EVENTS=
	! /TIME=
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

Select_Active_File 
/FILE_NAME=GLOBAL 
!/QUERY=
;

! ==================================
! ! Load normative data for kinematic data
! ==================================
!open normative file for kinematic data
Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=("&::normative_data&" = "Custom")
! /AS_INTEGER=TRUE
;

	File_Open
	! /FILE_NAME=
	! /SUFFIX=
	/SET_PROMPT=Select normative data (.vnd) file!
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(("&::normative_data&" <> "Custom") &::AMP& ("&::normative_file_exists&" = "TRUE"))
! /AS_INTEGER=TRUE
;

	File_Open
	/FILE_NAME=&::normative_file
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

File_Open
/FILE_NAME=&::normative_directory&TSP_normatives.vnd
;

Select_Active_File
/FILE_NAME=Static
! /QUERY=
;

Metric_Explicit
/RESULT_METRIC_NAME=GLOBAL::Height
/RESULT_METRIC_FOLDER=SUBJECT
/METRIC_VALUE=MODEL::METRIC::HEIGHT
;

Metric_Explicit
/RESULT_METRIC_NAME=GLOBAL::Weight
/RESULT_METRIC_FOLDER=SUBJECT
/METRIC_VALUE=MODEL::METRIC::MASS
;

Select_Active_File 
/FILE_NAME=Dynamic
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SUBJECT::LegLengthLeft
/RESULT_NAME=LegLengthLeft
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SUBJECT
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::SUBJECT::LegLengthRight
/RESULT_NAME=LegLengthRight
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SUBJECT
;

!=================================================
!Compute temporal and distance data for report
! for both conditions
!=================================================
Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(STRING_FIND("&::event_mode&","Instrumented treadmill",0) <> -1)
! /AS_INTEGER=TRUE
;

	Metric_Compute_Temporal_Distance
	/GLOBAL_RESULT_METRIC_FOLDER=TMPD
	/CALCULATE_PER_FILE=TRUE
	/CREATE_ALL_INSTANCES=TRUE
	/RHS_EVENT=RHS
	/LHS_EVENT=LHS
	/RTO_EVENT=RTO
	/LTO_EVENT=LTO
	/STRICT_EVENT_SEQUENCE_VALIDATION=TRUE
	! /COMPUTE_SPEED=TRUE
	! /COMPUTE_STATURES_PER_SECOND=TRUE
	! /COMPUTE_STRIDE_WIDTH=TRUE
	! /COMPUTE_STRIDE_LENGTH=TRUE
	! /COMPUTE_CYCLE_TIME=TRUE
	! /COMPUTE_STEP_LENGTH=TRUE
	! /COMPUTE_STEP_TIME=TRUE
	! /COMPUTE_STANCE_TIME=TRUE
	! /COMPUTE_SWING_TIME=TRUE
	! /COMPUTE_STEPS_PER_MINUTE=TRUE
	! /COMPUTE_STRIDES_PER_MINUTE=TRUE
	! /COMPUTE_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	! /COMPUTE_RIGHT_INITIAL_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	! /COMPUTE_RIGHT_TERMINAL_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	/TREADMILL_SPEED=METRIC::TREADMILL::SPEED
	/TREADMILL_DIRECTION=METRIC::TREADMILL::WALKING_DIRECTION
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

Conditional_Statement
/ITERATION_PARAMETER_NAME=cond
/EXPRESSION=(STRING_FIND("&::event_mode&","Instrumented treadmill",0) = -1)
! /AS_INTEGER=TRUE
;

	Metric_Compute_Temporal_Distance
	/GLOBAL_RESULT_METRIC_FOLDER=TMPD
	/CALCULATE_PER_FILE=TRUE
	/CREATE_ALL_INSTANCES=TRUE
	/RHS_EVENT=RHS
	/LHS_EVENT=LHS
	/RTO_EVENT=RTO
	/LTO_EVENT=LTO
	/STRICT_EVENT_SEQUENCE_VALIDATION=TRUE
	! /COMPUTE_SPEED=TRUE
	! /COMPUTE_STATURES_PER_SECOND=TRUE
	! /COMPUTE_STRIDE_WIDTH=TRUE
	! /COMPUTE_STRIDE_LENGTH=TRUE
	! /COMPUTE_CYCLE_TIME=TRUE
	! /COMPUTE_STEP_LENGTH=TRUE
	! /COMPUTE_STEP_TIME=TRUE
	! /COMPUTE_STANCE_TIME=TRUE
	! /COMPUTE_SWING_TIME=TRUE
	! /COMPUTE_STEPS_PER_MINUTE=TRUE
	! /COMPUTE_STRIDES_PER_MINUTE=TRUE
	! /COMPUTE_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	! /COMPUTE_RIGHT_INITIAL_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	! /COMPUTE_RIGHT_TERMINAL_DOUBLE_LIMB_SUPPORT_TIME=TRUE
	;

Conditional_Statement_End
/ITERATION_PARAMETER_NAME=cond
;

!Preparing signal for web report to keep naming convention
Metric_Explicit
/RESULT_METRIC_NAME=Left_Stance_Time_Pct_Count
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Left_Stance_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=Right_Stance_Time_Pct_Count
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Right_Stance_Time_Count
;

!Left_initial... created for web report 
Metric_Explicit
/RESULT_METRIC_NAME=Left_Initial_Double_Limb_Support_Time
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time
;

Metric_Explicit
/RESULT_METRIC_NAME=Left_Initial_Double_Limb_Support_Time_Count
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=Left_Initial_Double_Limb_Support_Time_Mean
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=Left_Initial_Double_Limb_Support_Time_StdDev
/RESULT_METRIC_FOLDER=TMPD
/METRIC_VALUE=METRIC::TMPD::Right_Terminal_Double_Limb_Support_Time_StdDev
;

! Speed - calculate global SD
Generate_Metric
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TMPD
/SIGNAL_NAMES=Speed
/RESULT_METRIC_FOLDER=TMPD
/RESULT_METRIC_NAME=_STDDEV
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=TRUE
/METRIC_PROCESS=STANDARD_DEVIATION
! /RANGE_START=
! /RANGE_END=
;

!Strides per minute (mean of L+R sides)
Evaluate_Expression
/EXPRESSION=(METRIC::TMPD::Left_Strides_Per_Minute_Mean + METRIC::TMPD::Right_Strides_Per_Minute_Mean) / 2
/RESULT_NAME=Strides_per_Minute_Mean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Stride time in sec
Evaluate_Expression
/EXPRESSION=1 / METRIC::TMPD::Strides_per_Minute_Mean * 60
/RESULT_NAME=Stride_Time_Mean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Stance time as %gait cycle use by web
Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Right_Stance_Time / METRIC::TMPD::Right_Cycle_Time * 100
/RESULT_NAME=Right_Stance_Time_Pct
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Left_Stance_Time / METRIC::TMPD::Left_Cycle_Time * 100
/RESULT_NAME=Left_Stance_Time_Pct
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Cadence calculated from Step Time
Evaluate_Expression
/EXPRESSION=60 / (Append_As_Frames(METRIC::TMPD::Right_Step_Time,METRIC::TMPD::Left_Step_Time))
/RESULT_NAME=Cadence
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

Evaluate_Expression
/EXPRESSION=Metric_Mean(METRIC::TMPD::Cadence)
/RESULT_NAME=Cadence_Mean
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

Evaluate_Expression
/EXPRESSION=Metric_StdDev(60 / list(METRIC::TMPD::Left_Step_Time, METRIC::TMPD::Right_Step_Time))
/RESULT_NAME=Cadence_StdDev
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Left_Step_Time_Count + METRIC::TMPD::Right_Step_Time_Count
/RESULT_NAME=Cadence_Count
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

Evaluate_Expression
/EXPRESSION=GLOBAL::METRIC::TMPD::Left_Step_Time_Count + GLOBAL::METRIC::TMPD::Right_Step_Time_Count
/RESULT_NAME=GLOBAL::Cadence_Count
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Calculation of Stance time % and Cadence require special way to calculate SD for Word same way as other parameters (mean of all cycles, not sd of mean all trials)
Set_Pipeline_Parameter_To_List_Of_Tagged_Files
/PARAMETER_NAME=files
/TAG_NAME=Dynamic
! /GET_CURRENT_SELECTED_FILES=false
! /USE_SHORT_FILENAMES=false
;

For_Each
/ITERATION_PARAMETER_NAME=filename
/ITERATION_PARAMETER_COUNT_NAME=inc
/ITEMS=::files
;

	Select_Active_File
	/FILE_NAME=::filename
	! /QUERY=
	;

	Evaluate_Expression
	/EXPRESSION=METRIC::TMPD::Left_Stance_Time_Pct
	/RESULT_NAME=GLOBAL::Left_Stance_Time_Pct_&::inc
	/RESULT_TYPE=METRIC
	/RESULT_FOLDER=TEMP
	;

	! add to string only if exists as Merge_Data later would fail on merging nonexistant data
	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=Data_Exists(GLOBAL::METRIC::TEMP::Left_Stance_Time_Pct_&::inc&)
	! /AS_INTEGER=TRUE
	;

		Set_Pipeline_Parameter
		/PARAMETER_NAME=pp_left
		/PARAMETER_VALUE=&::pp_left&Left_Stance_Time_Pct_&::inc&+
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Evaluate_Expression
	/EXPRESSION=METRIC::TMPD::Right_Stance_Time_Pct
	/RESULT_NAME=GLOBAL::Right_Stance_Time_Pct_&::inc
	/RESULT_TYPE=METRIC
	/RESULT_FOLDER=TEMP
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=Data_Exists(GLOBAL::METRIC::TEMP::Right_Stance_Time_Pct_&::inc&)
	! /AS_INTEGER=TRUE
	;

		Set_Pipeline_Parameter
		/PARAMETER_NAME=pp_right
		/PARAMETER_VALUE=&::pp_right&Right_Stance_Time_Pct_&::inc&+
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

	Evaluate_Expression
	/EXPRESSION=METRIC::TMPD::Cadence
	/RESULT_NAME=GLOBAL::Cadence_&::inc
	/RESULT_TYPE=METRIC
	/RESULT_FOLDER=TEMP
	;

	Conditional_Statement
	/ITERATION_PARAMETER_NAME=cond
	/EXPRESSION=Data_Exists(GLOBAL::METRIC::TEMP::Cadence_&::inc&)
	! /AS_INTEGER=TRUE
	;

		Set_Pipeline_Parameter
		/PARAMETER_NAME=pp_cadence
		/PARAMETER_VALUE=&::pp_cadence&Cadence_&::inc&+
		;

	Conditional_Statement_End
	/ITERATION_PARAMETER_NAME=cond
	;

End_For_Each
/ITERATION_PARAMETER_NAME=filename
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_left_con
/EXPRESSION=STRING_LENGTH("&::pp_left&") - 1
! /AS_INTEGER=TRUE
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_left
/EXPRESSION=STRING_LEFT("&::pp_left&", &::pp_left_con&)
! /AS_INTEGER=TRUE
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_right_con
/EXPRESSION=STRING_LENGTH("&::pp_right&") - 1
! /AS_INTEGER=TRUE
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_right
/EXPRESSION=STRING_LEFT("&::pp_right&", &::pp_right_con&)
! /AS_INTEGER=TRUE
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_cadence_con
/EXPRESSION=STRING_LENGTH("&::pp_cadence&") - 1
! /AS_INTEGER=TRUE
;

Set_Pipeline_Parameter_From_Expression
/PARAMETER_NAME=pp_cadence
/EXPRESSION=STRING_LEFT("&::pp_cadence&", &::pp_cadence_con&)
! /AS_INTEGER=TRUE
;

Select_Active_File
/FILE_NAME=GLOBAL
! /QUERY=
;

Merge_Data
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TEMP
/SIGNAL_NAMES=&::pp_left&
/SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=TMPD
/RESULT_NAME=GLOBAL::Left_Stance_Time_Pct
! /MERGE_TYPE=APPEND_TO_END
;

Merge_Data
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TEMP
/SIGNAL_NAMES=&::pp_right&
/SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=TMPD
/RESULT_NAME=GLOBAL::Right_Stance_Time_Pct
! /MERGE_TYPE=APPEND_TO_END
;

Merge_Data
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TEMP
/SIGNAL_NAMES=&::pp_cadence&
/SIGNAL_COMPONENTS=
! /COMPONENT_SEQUENCE=
/RESULT_TYPES=METRIC
/RESULT_FOLDERS=TMPD
/RESULT_NAME=GLOBAL::Cadence
! /MERGE_TYPE=APPEND_TO_END
;

Metric_Mean
/RESULT_METRIC_FOLDER=TMPD
/RESULT_METRIC_NAME=Left_Stance_Time_Pct_Mean+Right_Stance_Time_Pct_Mean+Cadence_Mean
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TMPD
/SIGNAL_NAMES=Left_Stance_Time_Pct+Right_Stance_Time_Pct+Cadence
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE=
/EXCLUDE_EVENTS=
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Metric_StdDev
/RESULT_METRIC_FOLDER=TMPD
/RESULT_METRIC_NAME=Left_Stance_Time_Pct_StdDev+Right_Stance_Time_Pct_StdDev+Cadence_StdDev
/APPLY_AS_SUFFIX_TO_SIGNAL_NAME=FALSE
/SIGNAL_TYPES=METRIC
/SIGNAL_FOLDER=TMPD
/SIGNAL_NAMES=Left_Stance_Time_Pct+Right_Stance_Time_Pct+Cadence
! /COMPONENT_SEQUENCE=
/EVENT_SEQUENCE=
/EXCLUDE_EVENTS=
! /GENERATE_MEAN_AND_STDDEV=TRUE
! /APPEND_TO_EXISTING_VALUES=FALSE
;

Select_Active_File
/FILE_NAME=Dynamic
! /QUERY=
;

!Normalise temporal/spatial data based on leg length following U of Salford method
Select_Active_File 
/FILE_NAME=GLOBAL
;

Evaluate_Expression
/EXPRESSION=(METRIC::SUBJECT::LegLengthLeft + METRIC::SUBJECT::LegLengthRight) / 2
/RESULT_NAME=LegLengthAvg
/RESULT_TYPE=METRIC
/RESULT_FOLDER=SUBJECT
;

!Speed / sqrt(9.81*leg length)
Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Speed/sqrt(9.81*METRIC::SUBJECT::LegLengthAvg)
/RESULT_NAME=SpeedNorm
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!(Cadence/60)/SQRT(9.81/leg length in mm)
Evaluate_Expression
/EXPRESSION=((METRIC::TMPD::Left_Strides_Per_Minute_Mean+METRIC::TMPD::Right_Strides_Per_Minute_Mean)/60)/sqrt(9.81/METRIC::SUBJECT::LegLengthAvg)
/RESULT_NAME=CadenceNorm
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Stride length/leg length
Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Stride_Length_Mean/METRIC::SUBJECT::LegLengthAvg
/RESULT_NAME=Stride_LengthNorm
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Left Step Length/leg length
Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Left_Step_Length_Mean/METRIC::SUBJECT::LegLengthAvg
/RESULT_NAME=Left_Step_LengthNorm
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Right Step Length/leg length
Evaluate_Expression
/EXPRESSION=METRIC::TMPD::Right_Step_Length_Mean/METRIC::SUBJECT::LegLengthAvg
/RESULT_NAME=Right_Step_LengthNorm
/RESULT_TYPE=METRIC
/RESULT_FOLDER=TMPD
;

!Express normalised metrics as %normal (after adjusting for leg length)
For_Each
/ITERATION_PARAMETER_NAME=SIG_NAME
/ITEMS=SpeedNorm+CadenceNorm+Stride_LengthNorm+Left_Step_LengthNorm+Right_Step_LengthNorm
;

	Evaluate_Expression
	/EXPRESSION=METRIC::TMPD::&::SIG_NAME&/P2D::TSP_Normatives::&::SIG_NAME&:&:2*100
	/RESULT_NAME=&::SIG_NAME&PctDiff
	/RESULT_TYPE=METRIC
	/RESULT_FOLDER=TMPD
	;

End_For_Each
/ITERATION_PARAMETER_NAME=SIG_NAME
;

!================================
!Rename/Copy Metrics as names are too long to be used in Word
!================================
Select_Active_File 
/FILE_NAME=GLOBAL 
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideLenCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Length_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideLenSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Length_Stddev
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideLenMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Length_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideWidCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Width_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideWidSD
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Width_StdDev
;

Metric_Explicit
/RESULT_METRIC_NAME=StrideWidMean
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Stride_Width_Mean
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepLenCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Right_Step_Length_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=LStepLenCount
/RESULT_METRIC_FOLDER=SHORT
/METRIC_VALUE=METRIC::TMPD::Left_Step_Length_Count
;

Metric_Explicit
/RESULT_METRIC_NAME=RStepLenMean
