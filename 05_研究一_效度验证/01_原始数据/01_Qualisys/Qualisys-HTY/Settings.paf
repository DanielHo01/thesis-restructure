Analyses:
    Visual3D Analysis (LB):
        Type: Visual3D
        Pipeline template: Scripts\src\Visual3D\pipeline_analyze.v3s
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$.cmz
        Do not wait for Visual3D: Yes
    Word Report (LB):
        Type: Compound
        Components: [Internal Export Word, Internal generate report descriptor, Internal Generate report (LB)]
        Prerequisites: [Visual3D Analysis (LB)]
    Visual3D Analysis (FB):
        Type: Visual3D
        Pipeline template: Scripts\src\Visual3D\pipeline_analyze.v3s
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$.cmz
        Do not wait for Visual3D: Yes
    Word Report (FB):
        Type: Compound
        Components: [Internal Export Word, Internal generate report descriptor, Internal Generate report (FB)]
        Prerequisites: [Visual3D Analysis (FB)]
    Compare sessions:
        Type: Compound
        Components: [Internal Compare sessions, Generate Comparison report descriptor, Internal Generate Comparison report]
        Decrypt: Yes
    Offline web report:
        Type: Compound
        Components: [Internal Export Web, Internal export marker data, Internal encode video (offline), Internal generate json, Internal generate offline web report]
    Online web report:
        Type: Compound
        Components: [Internal Export Web, Internal export marker data, Internal encode video (online), Internal generate online web report]
        Decrypt: Yes
    Internal Export Web:
        Type: Visual3D
        Pipeline template: Scripts\src\Visual3D\pipeline_export.v3s
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$_exp.cmz
        Close Visual3D: Never
    Internal Export Word:
        Type: Visual3D
        Pipeline template: Scripts\src\Visual3D\pipeline_export.v3s
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$_exp.cmz
        Close Visual3D: Never
    Internal Generate report (FB):
        Type: Report
        Word template: Assets\Word Templates\Report_template.docx
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$.docx
    Internal Generate report (LB):
        Type: Report
        Word template: Assets\Word Templates\Report_template.docx
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$.docx
    Internal Generate Comparison report:
        Type: Report
        Word template: Assets\Word Templates\Report_template.docx
        Output file: Report_$Patient ID$_$Last name$_$Test condition$_$Creation date$_comp.docx
    Internal Compare sessions:
        Type: Visual3D
        Pipeline template: Scripts\src\Visual3D\pipeline_compare.v3s
        Close Visual3D: Never
        Output file: Report_$Patient ID$_$Creation date$_comp.cmz
        Decrypt: Yes
    Internal generate report descriptor:
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
        Output file: objects.xml
    Generate Comparison report descriptor:
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
        Output file: objects.xml
    Internal export marker data:
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
    Internal generate json:
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
    Internal generate offline web report:
        Decrypt: No
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
        Output file: log.txt
    Internal encode video (offline):
        Decrypt: Yes
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
    Internal encode video (online):
        Decrypt: Yes
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
    Internal generate online web report:
        Decrypt: Yes
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
    CGM2 Web Report:
        Type: Compound
        Components: [Internal Generate Session, Internal Generate Upload Token, Internal encode video (online), Internal Run CGM2 Web, Internal Delete Upload Token]
    CGM2 PDF Report:
        Type: Compound
        Components: [Internal Generate Session, Internal Run CGM2 PDF]
    Internal Generate Session:
        Type: Instantiate template
        Export session: Yes
        Template: Templates\Scripts\src\CGM2\sessionConfig.yaml.php
        Output file: sessionConfig.yaml
    Internal Run CGM2 Web:
        Type: External program
        Program display name: QCGM2
        Export session: No
        Export measurements: c3d
        Arguments: [--templates-path, $TemplateDirectory$, --web-report]
    Internal Run CGM2 PDF:
        Type: External program
        Program display name: QCGM2
        Export session: No
        Export measurements: c3d
        Arguments: [--templates-path, $TemplateDirectory$, --pdf-report]
    Internal Generate Upload Token:
        Type: Instantiate template
        Decrypt: Yes
        Template: Templates\Scripts\dispatch.php
    Internal Delete Upload Token:
        Type: Instantiate template
        Template: Templates\Scripts\dispatch.php
Fields:
    Patient ID:
        Type: String
        Force: Yes
        Inherit: Connect
    Case ID:
        Type: String
        Inherit: Connect
    First name:
        Type: String
        Inherit: Connect
        Force: Yes
    Last name:
        Type: String
        Inherit: Connect
        Force: Yes
    Date of birth:
        Type: Date
    Session date:
        Type: Date
        Readonly: Yes
    Creation date:
        Type: Date
        Readonly: Yes
    Creation time:
        Type: TimeOfDay
        Readonly: Yes
    Height:
        Type: Float
        Quantity: Length
        Unit: Meters
        Decimals: 2
        Max: 2.5
        Min: 0
    Weight:
        Type: Float
        Quantity: Mass
        Unit: Kilograms
        Decimals: 1
        Max: 300
        Min: 1
    Sex:
        Type: Enum
        Values: [unspecified, female, male]
    Treadmill speed:
        Type: Float
        Quantity: Speed
        Decimals: 2
        Units: meters per second
    Measurement type:
        Type: Enum
        Values: [Static, Dynamic]
        Default: Dynamic
        Hidden: Yes
    Model:
        Type: Enum
        Values: [unspecified, Full Body, Lower Limb, Foot Markers+Sacrum, No, Foot+Sacrum+Arms, Foot]
        Default: unspecified
        Inherit: Copy
        Hidden: Yes
    Append model:
        Type: String
        Hidden: Yes
    Model used:
        Type: String
        Hidden: Yes
    Event mode:
        Type: Enum
        Values: [Manual, Multiple forceplates, No forceplate (automatic), No forceplate (using template file), Single forceplate, Instrumented treadmill (split belt), Instrumented treadmill (single belt)]
        Default: Multiple forceplates
    Test condition:
        Type: String
        Default: unspecified
    Test operator:
        Type: String
        Default: unspecified
    Marker diameter:
        Type: Float
        Quantity: Length
        Unit: Millimeters
        Decimals: 1
        Max: 40
        Min: 0
        Default: 0.014
    Affected side:
        Type: Enum
        Default: unspecified
        Values: [unspecified, Left, Right, Both]
    Diagnosis:
        Type: String
        Default: unspecified
    Secondary diagnosis:
        Type: String
        Default: unspecified
    Normative data:
        Type: Enum
        Values: [Adults, Children (all), Custom, Default]
        Default: Default
    Gross Motor Function Classification:
        Type: Enum
        Values: [Level I, Level II, Level III, Level IV, Level V, unspecified]
        Default: unspecified
    Functional Mobility Scale:
        Type: String
        Default: unspecified
    Left foot normalised to static trial:
        Type: Boolean
        Default: Yes
        Display: checkbox
    Right foot normalised to static trial:
        Type: Boolean
        Default: Yes
        Display: checkbox
    Head normalised to static trial:
        Type: Boolean
        Default: Yes
        Display: checkbox
    Multisegment foot:
        Type: Enum
        Values: [None, Oxford, Rizzoli]
        Default: None
