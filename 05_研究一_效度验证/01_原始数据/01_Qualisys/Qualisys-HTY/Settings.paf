Project ID: PAF Salford
Root type: Subject
Default fields: [Creation date, Creation time]
Date format: Iso
Date separator: Dash
Filename filter: \.(pdf|docx|cmz|cmo|r3w|jpg|jpeg|html)$
Package Information:
    Name: Gait
    Version: 1.5.0+158
    Required QTM version: 2018.1.4180
    Release date: 2020-07-03
    Previous names: [Gait Visual3D, Clinical Gait Visual3D]
Types:
    Subject:
        Patient:
            Fields: [Patient ID, First name, Last name, Date of birth, Sex, Normatives]
            Children: [Session]
            Directory pattern: $Last name$_$First name$_$Date of birth$_$Patient ID$
            Icon: Assets\Icons\paf_patient.ico
    Session:
        Fields: [Case ID, Test operator, Session date, Diagnosis, Secondary diagnosis, Affected side, Gross Motor Function Classification, Functional Mobility Scale, Height, Weight, Leg length left, Leg length right, Knee width left, Knee width right, Ankle width left, Ankle width right, Sole delta left, Sole delta right, Shoulder offset left, Shoulder offset right, Elbow width left, Elbow width right, Wrist width left, Wrist width right, Hand thickness left, Hand thickness right, Marker diameter]
        Gait Session:
            Directory pattern: $Session date$
            Display order: [Patient ID, First name, Last name, Case ID, Date of birth, Test condition, Test operator, Comments, Session date, Creation date, Creation time, Diagnosis, Secondary diagnosis, Affected side, Gross Motor Function Classification, Functional Mobility Scale, Height, Weight, Leg length left, Leg length right, Knee width left, Knee width right, Ankle width left, Ankle width right, Sole delta left, Sole delta right, Shoulder offset left, Shoulder offset right, Elbow width left, Elbow width right, Wrist width left, Wrist width right, Hand thickness left, Hand thickness right, Marker diameter]
            Fields: [Session date]
            Children: [Subsession]
    Subsession:
        CAST - Lower body session:
            Fields: [Event mode, Test condition, Prothesis_Orthosis, External aid, External aid side, Personal aid, Personal aid side, Left foot normalised to static trial, Right foot normalised to static trial, Multisegment foot, Normative data, Static analysis result, Web Report IDs, Update existing web report]
            Model used: CAST
            Display order: [Patient ID, Case ID, First name, Last name, Test condition, Test operator, Date of birth, Height, Weight, Comments, Creation date, Creation time, Diagnosis, Secondary diagnosis, Affected side, Prothesis_Orthosis, External aid, External aid side, Personal aid, Personal aid side, Gross Motor Function Classification, Functional Mobility Scale, Leg length left, Leg length right, Knee width left, Knee width right, Ankle width left, Ankle width right]
            Measurements: [Static LB Anterior - CAST, Static LB Posterior - CAST, Gait LB - CAST]
            Analyses: [Visual3D Analysis (LB), Word Report (LB), Offline web report, Online web report, Compare sessions]
            Directory pattern: $Creation date$_$Test condition$
            PDF guide: ..\Documentation\CAST_Marker_Set_Lower_Body.pdf
            Icon: Assets\Icons\paf_session.ico
        CAST - Full body session:
            Fields: [Event mode, Test condition, Prothesis_Orthosis, External aid, External aid side, Personal aid, Personal aid side, Left foot normalised to static trial, Right foot normalised to static trial, Multisegment foot, Normative data, Static analysis result, Web Report IDs, Update existing web report]
